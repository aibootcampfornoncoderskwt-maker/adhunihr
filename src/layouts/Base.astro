---
import Splash from '../components/Splash.astro';
import Header from '../components/Header.astro';
import WhatsApp from '../components/WhatsApp.astro';
import QuickMatch from '../components/QuickMatch.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/home-polish.css';
import '../styles/buttons.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
interface Props {title?:string;description?:string;noindex?:boolean;image?:string;pageType?:string;breadcrumbs?:{name:string;href:string}[];mainEntity?:Record<string,unknown>;}
const {title='Manpower & Recruitment | Adhuni HR Solutions',description='Reliable manpower sourcing and recruitment solutions for businesses across industries, with a strong focus on the Middle East.',noindex=false,image='/images/hero-gcc.webp',pageType='WebPage',breadcrumbs=[],mainEntity}=Astro.props;
const launch=import.meta.env.PUBLIC_LAUNCH_READY==='true';
// Google Analytics 4 loads only when PUBLIC_GA_MEASUREMENT_ID is set (and the privacy notice has been updated to say so).
const gaId=/^G-[A-Z0-9]{6,}$/.test((import.meta.env.PUBLIC_GA_MEASUREMENT_ID||'').trim())?(import.meta.env.PUBLIC_GA_MEASUREMENT_ID||'').trim():'';
const canonical=new URL(Astro.url.pathname,Astro.site);
const absolute=(path:string)=>new URL(path,Astro.site).href;
const organisationId=absolute('/#organisation'),websiteId=absolute('/#website'),pageId=canonical.href+'#webpage';
const organization={'@type':'Organization','@id':organisationId,name:'Adhuni HR Solutions',logo:absolute('/images/adhuni-approved.png'),url:absolute('/'),description:'Multi-industry manpower sourcing and recruitment, with a strong focus on the Middle East / GCC.'};
const crumbs=[{name:'Home',href:'/'},...breadcrumbs];
const schema={'@context':'https://schema.org','@graph':[organization,{'@type':'WebSite','@id':websiteId,url:absolute('/'),name:'Adhuni HR Solutions',publisher:{'@id':organisationId}}, {'@type':pageType,'@id':pageId,url:canonical.href,name:title,description,inLanguage:'en',isPartOf:{'@id':websiteId},primaryImageOfPage:{'@type':'ImageObject',url:absolute(image)},...(breadcrumbs.length?{breadcrumb:{'@id':canonical.href+'#breadcrumb'}}:{}),...(mainEntity?{mainEntity:{'@id':canonical.href+'#service'}}:{})},...(breadcrumbs.length?[{'@type':'BreadcrumbList','@id':canonical.href+'#breadcrumb',itemListElement:crumbs.map((crumb,index)=>({'@type':'ListItem',position:index+1,name:crumb.name,item:absolute(crumb.href)}))}]:[]),...(mainEntity?[{...mainEntity,'@id':canonical.href+'#service',url:canonical.href,provider:{'@id':organisationId},areaServed:['Kuwait','Saudi Arabia','United Arab Emirates','Qatar','Oman','Bahrain']}]:[])]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="format-detection" content="telephone=no,date=no,address=no,email=no"/><meta name="theme-color" content="#12365A"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={launch&&!noindex?'index, follow':'noindex, nofollow'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon-approved.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Adhuni HR Solutions"/><meta property="og:image" content={absolute(image)}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={absolute(image)}/>{gaId&&<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}{gaId&&<script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}',{anonymize_ip:true});`}></script>}<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/><slot name="head"/></head><body id="top"><Splash/><div id="site-shell"><script is:inline>if(document.documentElement.dataset.intro==='active')document.currentScript.parentElement.inert=true;</script><a class="skip-link" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/><WhatsApp/><QuickMatch/></div><script>import '../scripts/site';import '../scripts/home-reveal';import '../scripts/hero-fit';import '../scripts/hero-words';</script></body></html>
