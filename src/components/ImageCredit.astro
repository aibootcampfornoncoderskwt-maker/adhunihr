---
const {image}=Astro.props;
const credits:Record<string,{name:string;author:string;url:string;license:string;licenseUrl:string}>={
'oil-refinery.webp':{name:'Hemmingstedt refinery',author:'Dirk Ingo Franke',url:'https://commons.wikimedia.org/wiki/File:Hemmingstedt_raffinerie_nacht_uebersichtlich.JPG',license:'CC BY-SA 2.0 DE',licenseUrl:'https://creativecommons.org/licenses/by-sa/2.0/de/'},
'hospitality.webp':{name:'Tables and Chairs in Modern Restaurant',author:'Vidal Balielo Jr.',url:'https://www.pexels.com/photo/tables-and-chairs-in-modern-restaurant-12688956/',license:'Pexels licence',licenseUrl:'https://www.pexels.com/license/'}};
const credit=credits[image];
---
{credit&&<details class="photo-credits"><summary>About this image</summary><p><a href={credit.url}>{credit.name}</a> — {credit.author}. <a href={credit.licenseUrl}>{credit.license}</a>. Converted to WebP and cropped for display. An illustrative industry setting, not an Adhuni project.</p></details>}
