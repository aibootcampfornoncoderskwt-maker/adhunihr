---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import PageQuestions from './PageQuestions.astro';
import ImageCredit from './ImageCredit.astro';
import {services,industries,countries} from '../data/site';
import {industryPhoto,sectorMedia} from '../data/sector-media';
interface Props {kind:'service'|'industry';item:typeof services[number]|typeof industries[number];}
const {kind,item}=Astro.props;
const isService=kind==='service';
const photo=isService?undefined:industryPhoto[item.slug];
const heroImage=photo?`/industries/${photo}.webp`:item.image;
const heroAlt=photo?sectorMedia[item.slug].alt:item.alt;
const parent={name:isService?'Services':'Industries',href:isService?'/services/':'/industries/'};
const enquiry=`/employers/?${isService?'service':'industry'}=${encodeURIComponent(isService?item.slug:item.title)}#request-form`;
const related='industries' in item?industries.filter(i=>item.industries.includes(i.slug)):services.filter(s=>item.services.includes(s.slug));
const questions='faqs' in item?item.faqs:[[item.question,item.answer],['Which recruitment services can support this industry?','The service options below can help frame the discussion. The right approach depends on the role, number of vacancies, duration and required experience. Agree the scope after sharing your hiring brief.'],['Are these roles current vacancies?','No. These are examples of recruitment requirements for discussion. Candidates can submit their profile for consideration against suitable opportunities; registration does not guarantee employment.']];
const title=isService?item.title:`${item.title} Recruitment`;
const mainEntity={'@type':'Service',name:title,serviceType:isService?item.title:`Recruitment for ${item.title}`,description:item.description};
---
<Base title={`${title} | Adhuni HR Solutions`} description={item.description} image={photo?heroImage:`/images/${item.image}`} breadcrumbs={[parent,{name:item.title,href:Astro.url.pathname}]} mainEntity={mainEntity}>
<PageHero eyebrow={item.title} title={title} description={item.description} image={heroImage} alt={heroAlt} parent={parent} cta={{label:'Request Candidates',href:enquiry}}/>
<div class="page-section-nav"><nav class="container" aria-label="On this page"><a href="#overview">Overview</a><a href="#roles">{isService?'Service scope':'Roles & responsibilities'}</a><a href="#hiring-brief">Hiring brief</a><a href="#questions">Questions & answers</a></nav></div>
<section id="overview" class="section"><div class="container page-editorial"><div><div class="eyebrow">{isService?'THE SERVICE':'SECTOR UNDERSTANDING'}</div><h2>{'intro' in item?item.intro:'Start with the work behind the role.'}</h2></div><div class="page-prose"><p class="lead">{item.overview}</p><p>{item.focus}</p></div></div></section>
<section id="roles" class="section surface"><div class="container page-two-col"><div><div class="eyebrow">{isService?'WHAT WE CAN SUPPORT':'ROLE EXAMPLES'}</div><h2>{isService?'A clear scope for your requirement.':'Build a team around your operation.'}</h2><ul class="page-role-list">{item.roles.map((role,index)=><li><span aria-hidden="true">0{index+1}</span><strong>{role}</strong></li>)}</ul>{!isService&&<p class="small-note">Role examples describe hiring discussions, not advertised vacancies.</p>}</div><aside id="hiring-brief" class="page-brief"><div class="eyebrow">WHAT TO INCLUDE</div><h2>Your hiring brief.</h2><p>Clear requirements make candidate review more relevant. Include these details when you contact our team.</p><ul>{item.brief.map(point=><li>{point}</li>)}</ul><a href={enquiry} class="button navy">Request Candidates →</a></aside></div></section>
{'steps' in item&&<section class="section"><div class="container"><div class="eyebrow">HOW IT WORKS</div><h2>From the brief to the next step.</h2><ol class="page-process">{item.steps.map((step,index)=><li><span>0{index+1}</span><h3>{step}</h3></li>)}</ol><a class="text-link" href="/our-approach/">Explore our complete recruitment process →</a></div></section>}
<section id="questions" class="section"><div class="container faq-wrap"><div><div class="eyebrow">PRACTICAL ANSWERS</div><h2>Before you start.</h2><p class="section-intro">A clearer brief starts with the right questions.</p><a class="text-link" href="/contact/">Ask our team →</a></div><PageQuestions questions={questions}/></div></section>
<section class="section surface"><div class="container"><div class="section-heading"><div><div class="eyebrow">CONNECTED EXPERTISE</div><h2>{isService?'Explore relevant industries.':'Choose the right recruitment service.'}</h2></div><a class="text-link" href={isService?'/industries/':'/services/'}>View all →</a></div><div class="page-related">{related.map(entry=><a href={`/${isService?'industries':'services'}/${entry.slug}/`}><h3>{entry.title}</h3><p>{entry.description}</p><span class="text-link">Explore →</span></a>)}</div></div></section>
<section class="section"><div class="container"><div class="eyebrow">MIDDLE EAST / GCC FOCUS</div><h2>Bring the role and the market together.</h2><p class="section-intro">Share the work location and destination requirements as part of your brief. Recruitment scope and joining responsibilities are agreed for each engagement.</p><div class="journey-markets">{countries.map(country=><a href={`/locations/${country.slug}/${isService?`?service=${item.slug}`:''}`}><span class={`flag flag-${country.code}`} aria-hidden="true"></span><strong>{country.name}</strong><span aria-hidden="true">→</span></a>)}</div><div class="page-end-cta"><div><h2>Let’s discuss your next hire.</h2><p>Tell us the role, the requirement and the expected timing.</p></div><a class="button navy" href={enquiry}>Request Candidates →</a></div><ImageCredit image={item.image}/></div></section>
</Base>
