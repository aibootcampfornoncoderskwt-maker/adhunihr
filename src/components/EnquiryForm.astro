---
import fields from '../data/enquiry-fields.json';
import EnquiryFields from './EnquiryFields.astro';
import {services} from '../data/site';
import Icon from './Icon.astro';
interface Props {type:'employer'|'candidate'|'general';}
const {type}=Astro.props;
const enabled=import.meta.env.PUBLIC_CONTACT_ENABLED==='true';
const key=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const button={employer:'Send Request',candidate:'Submit Your CV',general:'Send Enquiry'}[type];
const success={employer:'Thank you. Your requirement is on its way. We will reply within one business day.',candidate:'Thank you. We have received your CV and will contact you when a role matches your skills and experience.',general:'Thank you. Your enquiry is on its way. We will reply within one business day.'}[type];
---
<form class="contact-form client-form" data-contact-form data-enabled={String(enabled)} data-success={success} method="post" action="/api/contact" enctype="multipart/form-data" novalidate>
<input type="hidden" name="type" value={type}/>
{type==='employer'?<>
<p class="employer-form-intro">Start with the essentials. Fields marked * are required.</p>
<fieldset class="enquiry-group"><legend><span>01</span> Your details</legend><div class="form-grid"><EnquiryFields prefix={type} items={['company','name','email','phone','designation'].map(n=>fields.employer.find(f=>f.name===n)!)}/></div></fieldset>
<fieldset class="enquiry-group"><legend><span>02</span> Hiring requirement</legend><div class="form-grid">
<label class="full">Recruitment service <span>(optional)</span><select name="service"><option value="">Help me choose</option>{services.map(service=><option value={service.slug}>{service.title}</option>)}</select></label>
<EnquiryFields prefix={type} items={fields.employer.filter(f=>['country','industry','position_job_title','number_of_vacancies'].includes(f.name))}/>
</div></fieldset>
<details class="enquiry-optional"><summary>Additional information <span>Optional — add role details and timing</span></summary><div class="form-grid"><EnquiryFields prefix={type} items={fields.employer.filter(f=>['qualification','experience_required','work_location','salary_benefits','expected_joining_date','job_description','additional_requirements'].includes(f.name))}/></div></details>
</>:<div class="form-grid"><EnquiryFields prefix={type} items={fields[type]}/></div>}
<div class="form-grid">
<div class="field full"><label class="consent"><input type="checkbox" name="consent" required aria-describedby={`${type}-consent-error`}/><span>I acknowledge that the information provided may be used to respond to my enquiry in accordance with privacy and recruitment practices. I have read the <a href="/privacy/">privacy notice</a>.</span></label><span class="field-error" id={`${type}-consent-error`}></span></div>
<div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div></div>
{enabled&&key&&<div class="cf-turnstile" data-sitekey={key}></div>}
{type!=='employer'?<button class="button amber submit-button" type="submit">{button} <span class="btn-arrow"><Icon name="arrow" size={16}/></span></button>:<button class="button amber submit-button" type="submit">{button} →</button>}<p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
{!enabled&&<p class="form-note">Enquiries are not being collected on this preview. The form will be available when the website launches.</p>}
</form>
