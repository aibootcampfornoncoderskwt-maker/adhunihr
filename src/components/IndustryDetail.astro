---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PageQuestions from './PageQuestions.astro';
import AudienceCta from './AudienceCta.astro';
import ImageCredit from './ImageCredit.astro';
import {services,industries} from '../data/site';
import {industryPhoto,sectorMedia} from '../data/sector-media';
import {industryExtras,visibleIndustryFaqs} from '../data/industry-content';
import {marketIndustries,marketCountries} from '../data/market-pages.mjs';
import {guide,guideLabels} from '../data/guides.mjs';
const guidesLive=import.meta.env.PUBLIC_GUIDES_LIVE==='true';
import '../styles/service.css';
import '../styles/country.css';
interface Props {item:typeof industries[number];}
const {item}=Astro.props;
const relatedGuides=(item.slug==='healthcare'?['healthcare-licensing-gcc','hiring-brief-gcc']:['hiring-brief-gcc','recruitment-process-brief-to-joining']);
const extra=industryExtras[item.slug];
const photo=industryPhoto[item.slug];
// The industry's card photo, cropped tighter, so card and hero never look identical.
const hero=extra?.hero??(photo?{image:`/industries/${photo}.webp`,alt:sectorMedia[item.slug].alt,position:'50% 45%',zoom:1.22}:{image:`/images/${item.image}`,alt:item.alt});
const heroPos=hero.position??'center';
const heroStyle=hero.zoom?`object-position:${heroPos};transform:scale(${hero.zoom});transform-origin:${heroPos}`:`object-position:${heroPos}`;
const heroText=extra?.heroText??item.description;
const title=`${item.title} Recruitment`;
const parent={name:'Industries',href:'/industries/'};
const requestHref=`/employers/?industry=${encodeURIComponent(item.title)}#request-form`;
const defaultQuestions:string[][]=[[item.question,item.answer],['Which recruitment services can support this industry?','The service options below can help frame the discussion. The right approach depends on the role, number of vacancies, duration and required experience. Agree the scope after sharing your hiring brief.'],['Are these roles current vacancies?','No. These are examples of recruitment requirements for discussion. Candidates can submit their profile for consideration against suitable opportunities; registration does not guarantee employment.']];
const questions=extra?.faqs?visibleIndustryFaqs(extra.faqs):defaultQuestions;
const pageTitle=extra?.seoTitle??title;
const pageDescription=extra?.seoDescription??item.description;
const relatedServices=(extra?.services??item.services).map(slug=>services.find(s=>s.slug===slug)).filter((s):s is NonNullable<typeof s>=>!!s);
const hasChecks=!!extra?.checks;
const mainEntity={'@type':'Service',name:title,serviceType:`Recruitment for ${item.title}`,description:item.description};
// FAQPage schema describes only the questions that are visible on the page.
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':new URL(Astro.url.pathname,Astro.site).href+'#faq',mainEntity:questions.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<Base title={`${pageTitle} | Adhuni HR Solutions`} description={pageDescription} image={hero.image} breadcrumbs={[parent,{name:item.title,href:Astro.url.pathname}]} mainEntity={mainEntity}>
<section class="sv-hero"><div class="container"><nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={parent.href}>{parent.name}</a><span aria-hidden="true">/</span><span aria-current="page">{item.title}</span></nav>
<div class="sv-hero-grid has-image"><div class="sv-hero-copy"><div class="eyebrow light">INDUSTRY</div><h1>{title}</h1><p>{heroText}</p><a class="button amber sv-btn" href={requestHref}>Request Candidates <span class="btn-arrow" aria-hidden="true"><Icon name="arrow" size={16}/></span></a></div><figure class="sv-hero-visual"><img src={hero.image} alt={hero.alt} width="1536" height="1024" fetchpriority="high" style={heroStyle}/></figure></div></div></section>
<div class="page-section-nav"><nav class="container" aria-label="On this page"><a href="#overview">Overview</a>{hasChecks&&<a href="#what-we-check">What we check</a>}<a href="#roles">Roles & responsibilities</a><a href="#hiring-brief">Hiring brief</a><a href="#questions">Questions & answers</a></nav></div>
<section id="overview" class="section"><div class="container sv-overview"><div><div class="eyebrow">SECTOR UNDERSTANDING</div><h2>{'intro' in item?item.intro:'Start with the work behind the role.'}</h2></div><div class="sv-overview-body">{extra?.overviewText?<p>{extra.overviewText}</p>:<><p class="lead">{item.overview}</p><p>{item.focus}</p></>}</div></div></section>
{extra?.checks&&<section id="what-we-check" class="section surface"><div class="container"><div class="eyebrow">WHAT WE CHECK</div><h2>What we check before we shortlist.</h2><ul class="sv-deliver">{extra.checks.map(c=><li><span class="sv-deliver-icon"><Icon name={c.icon} size={22}/></span><h3>{c.title}</h3><p>{c.text}</p></li>)}</ul></div></section>}
<section id="roles" class:list={['section',{surface:!hasChecks}]}><div class="container page-two-col"><div><div class="eyebrow">ROLE EXAMPLES</div><h2>Build a team around your operation.</h2><ul class="page-role-list">{extra?.roleGroups?extra.roleGroups.map((entry,index)=><li class="has-group"><span aria-hidden="true">0{index+1}</span><div><small class="role-group">{entry.group}</small><strong>{entry.role}</strong></div></li>):item.roles.map((role,index)=><li><span aria-hidden="true">0{index+1}</span><strong>{role}</strong></li>)}</ul><p class="small-note">Role examples describe hiring discussions, not advertised vacancies.</p></div><aside id="hiring-brief" class="page-brief"><div class="eyebrow">WHAT TO INCLUDE</div><h2>Your hiring brief.</h2><p>Clear requirements make candidate review more relevant. Include these details when you contact our team.</p><ul>{item.brief.map(point=><li>{point}</li>)}</ul><a href={requestHref} class="button amber sv-btn-plain">Request Candidates →</a></aside></div></section>
<section id="questions" class:list={['section',{'sv-divided':hasChecks}]}><div class="container faq-wrap"><div><div class="eyebrow">PRACTICAL ANSWERS</div><h2>Before you start.</h2><p class="section-intro">A clearer brief starts with the right questions.</p><a class="text-link" href="/contact/">Ask our team →</a></div><PageQuestions questions={questions}/></div></section>
<section id="related" class="section surface"><div class="container"><div class="section-heading"><div><div class="eyebrow">CONNECTED EXPERTISE</div><h2>Choose the right recruitment service.</h2></div><a class="text-link" href="/services/">View all →</a></div><div class="page-related">{relatedServices.map(entry=><a href={`/services/${entry.slug}/`}><h3>{entry.title}</h3><p>{entry.description}</p><span class="text-link">Explore →</span></a>)}</div><ImageCredit image={item.image}/></div></section>
{marketIndustries.includes(item.slug)&&<section class="section surface co-markets-section"><div class="container"><nav class="co-markets" aria-label="Recruitment by country"><span class="co-markets-label">By country</span><ul>{marketCountries.map(c=><li><a href={`/industries/${item.slug}/${c.slug}/`}>{c.en}</a></li>)}</ul></nav></div></section>}
{guidesLive&&<section class="section co-markets-section"><div class="container"><nav class="co-markets" aria-label={guideLabels.en.relatedGuides}><span class="co-markets-label">{guideLabels.en.relatedGuides}</span><ul>{relatedGuides.map(slug=><li><a href={`/guides/${slug}/`}>{guide(slug).en.title}</a></li>)}</ul></nav></div></section>}
<AudienceCta/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
<script>import '../scripts/section-nav';</script>
</Base>
