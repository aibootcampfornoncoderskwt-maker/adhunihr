---
import Icon from './Icon.astro';
import {industries} from '../data/site';
import {sectorMedia,featuredSectorSlugs} from '../data/sector-media';
interface Props {slugs?:string[];}
const {slugs=featuredSectorSlugs}=Astro.props;
const items=slugs.map(slug=>industries.find(item=>item.slug===slug)).filter((item):item is NonNullable<typeof item>=>!!item&&!!sectorMedia[item.slug]);
---
<div class="ind-grid">{items.map(item=><a class="ind-card" href={'/industries/'+item.slug+'/'}><img src={`/industries/${sectorMedia[item.slug].file}.webp`} srcset={`/industries/${sectorMedia[item.slug].file}-640.webp 640w, /industries/${sectorMedia[item.slug].file}.webp 1200w`} sizes="(max-width:600px) 100vw, (max-width:1000px) 50vw, 420px" alt={sectorMedia[item.slug].alt} width="1200" height="900" loading="lazy" decoding="async"/><div class="ind-overlay"><div class="ind-title"><h3>{item.title}</h3><span class="ind-arrow" aria-hidden="true"><Icon name="arrow" size={18}/></span></div><div class="ind-roles"><ul>{sectorMedia[item.slug].roles.map(role=><li>{role}</li>)}</ul></div></div></a>)}</div>
