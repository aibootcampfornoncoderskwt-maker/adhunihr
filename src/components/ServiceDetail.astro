---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PageQuestions from './PageQuestions.astro';
import ApproachSteps from './ApproachSteps.astro';
import IndustryCards from './IndustryCards.astro';
import AudienceCta from './AudienceCta.astro';
import {services} from '../data/site';
import {serviceExtras,visibleFaqs} from '../data/service-content';
import '../styles/service.css';
interface Props {item:typeof services[number];}
const {item}=Astro.props;
const extra=serviceExtras[item.slug];
const requestHref=`/employers/?service=${item.slug}#request-form`;
const heroSrc=extra.hero?(extra.hero.image.startsWith('/')?extra.hero.image:`/images/${extra.hero.image}`):'';
// A tighter crop keeps the hero from looking identical to the same photo used on an industry card.
const heroPos=extra.hero?.position??'center';
const heroStyle=extra.hero?.zoom?`object-position:${heroPos};transform:scale(${extra.hero.zoom});transform-origin:${heroPos}`:`object-position:${heroPos}`;
const heroText=extra.heroText??item.description;
const questions=extra.faqs?visibleFaqs(extra.faqs):item.faqs;
const relatedServices=extra.related.map(slug=>services.find(s=>s.slug===slug)).filter((s):s is NonNullable<typeof s>=>!!s);
const parent={name:'Services',href:'/services/'};
const mainEntity={'@type':'Service',name:item.title,serviceType:item.title,description:item.description};
// FAQPage schema describes only the questions that are visible on the page.
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':new URL(Astro.url.pathname,Astro.site).href+'#faq',mainEntity:questions.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<Base title={`${item.title} | Adhuni HR Solutions`} description={item.description} image={heroSrc||'/images/hero-gcc.webp'} breadcrumbs={[parent,{name:item.title,href:Astro.url.pathname}]} mainEntity={mainEntity}>
<section class="sv-hero"><div class="container"><nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={parent.href}>{parent.name}</a><span aria-hidden="true">/</span><span aria-current="page">{item.title}</span></nav>
<div class:list={['sv-hero-grid',{'has-image':!!extra.hero}]}><div class="sv-hero-copy"><div class="eyebrow light">RECRUITMENT SERVICE</div><h1>{item.title}</h1><p>{heroText}</p><a class="button amber sv-btn" href={requestHref}>Request Candidates <span class="btn-arrow" aria-hidden="true"><Icon name="arrow" size={16}/></span></a></div>{extra.hero&&<figure class="sv-hero-visual"><img src={heroSrc} alt={extra.hero.alt} width="1536" height="1024" fetchpriority="high" style={heroStyle}/></figure>}</div></div></section>
<div class="page-section-nav"><nav class="container" aria-label="On this page"><a href="#overview">Overview</a><a href="#roles">Service scope</a><a href="#hiring-brief">Hiring brief</a><a href="#questions">Questions & answers</a></nav></div>
<section id="overview" class="section"><div class="container sv-overview"><div><div class="eyebrow">THE SERVICE</div><h2>{item.intro}</h2></div><div class="sv-overview-body">{extra.bestFor&&<div class="sv-bestfor"><span class="sv-bestfor-label">Best for</span><p>{extra.bestFor}</p></div>}{extra.overviewText?<p>{extra.overviewText}</p>:<><p class="lead">{item.overview}</p><p>{item.focus}</p></>}</div></div></section>
{extra.deliverables&&<section id="what-you-get" class="section surface"><div class="container"><div class="eyebrow">WHAT YOU GET</div><h2>What you get with us.</h2><ul class="sv-deliver">{extra.deliverables.map(d=><li><span class="sv-deliver-icon"><Icon name={d.icon} size={22}/></span><h3>{d.title}</h3><p>{d.text}</p></li>)}</ul></div></section>}
<section id="roles" class="section"><div class="container page-two-col"><div><div class="eyebrow">ROLES WE FILL</div><h2>A clear scope for your requirement.</h2><ul class="page-role-list">{item.roles.map((role,index)=><li><span aria-hidden="true">0{index+1}</span><strong>{role}</strong></li>)}</ul></div><aside id="hiring-brief" class="page-brief"><div class="eyebrow">WHAT TO INCLUDE</div><h2>Your hiring brief.</h2><p>Clear requirements make candidate review more relevant. Include these details when you contact our team.</p><ul>{item.brief.map(point=><li>{point}</li>)}</ul><a href={requestHref} class="button amber sv-btn-plain">Request Candidates →</a></aside></div></section>
<section id="how-it-works" class="section appr appr--compact"><div class="appr-inner"><div class="appr-head"><div class="eyebrow light">HOW IT WORKS</div><h2>From brief to joining in five steps.</h2></div><ApproachSteps/><a class="sv-approach-link" href="/our-approach/">See our full approach <Icon name="arrow" size={16}/></a></div></section>
<section id="questions" class="section"><div class="container faq-wrap"><div><div class="eyebrow">PRACTICAL ANSWERS</div><h2>Before you start.</h2><p class="section-intro">A clearer brief starts with the right questions.</p><a class="text-link" href="/contact/">Ask our team →</a></div><PageQuestions questions={questions}/></div></section>
<section id="related" class="section surface"><div class="container"><div class="eyebrow">WHERE THIS SERVICE FITS</div><h2>Industries we hire for.</h2><IndustryCards slugs={extra.industries}/>{relatedServices.length>0&&<nav class="sv-related" aria-label="Related services"><span class="sv-related-label">Related services</span><ul>{relatedServices.map(entry=><li><a href={`/services/${entry.slug}/`}>{entry.title} <Icon name="arrow" size={16}/></a></li>)}</ul></nav>}</div></section>
<AudienceCta/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
<script>import '../scripts/section-nav';</script>
</Base>
