---
import Icon from './Icon.astro';
interface Props {eyebrow:string;title:string;description:string;image?:string;alt?:string;parent?:{name:string;href:string};cta?:{label:string;href:string;arrow?:string};crumb?:string;caption?:string;variant?:string;}
const {eyebrow,title,description,image,alt,parent,cta,crumb=eyebrow,caption='',variant}=Astro.props;
---
<section class:list={['page-hero',variant]}><div class="container"><nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{parent&&<><a href={parent.href}>{parent.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{crumb}</span></nav><div class:list={['page-hero-grid',{'no-image':!image}]}><div class="page-hero-copy"><div class="eyebrow light">{eyebrow}</div><h1>{title}</h1><p>{description}</p>{cta&&<a class="button amber" href={cta.href}>{cta.label} {(cta.arrow??'↗')==='→'?<span class="btn-arrow" aria-hidden="true"><Icon name="arrow" size={16}/></span>:<span class="page-hero-arrow" aria-hidden="true">{cta.arrow??'↗'}</span>}</a>}</div>{image&&<figure class="page-hero-visual"><img src={image.startsWith('/')?image:`/images/${image}`} alt={alt??''} width="1536" height="1024" fetchpriority="high"/>{caption&&<figcaption>{caption}</figcaption>}</figure>}</div></div></section>
