---
import Icon from './Icon.astro';
import {countries} from '../data/site';
import map from '../data/recruitment-map.json';
import {sourceCountries,destinationLabels,routes} from '../data/recruitment-network';
interface Props {eyebrow?:string;heading?:string;text?:string;}
const {eyebrow='WHERE WE RECRUIT',heading='One partner across six Middle East markets.',text="Hiring in more than one country? Tell us where, and we'll plan the search around that country's requirements."}=Astro.props;
// The map is generated by scripts/generate-recruitment-map.mjs: the GCC at a larger scale (left), the source countries (right). Routes cross into the GCC panel.
const mapPoints=map.destinations as Record<string,number[]>,mapSources=map.sources as Record<string,number[]>;
const mapArabic: Record<string, string> = {kuwait: 'الكويت', 'saudi-arabia': 'السعودية', uae: 'الإمارات', qatar: 'قطر', oman: 'عُمان', bahrain: 'البحرين'};
const diamond=(x:number,y:number,r:number)=>`M${x} ${y-r}L${x+r} ${y}L${x} ${y+r}L${x-r} ${y}Z`;
---
<section id="markets" class="section surface mk"><div class="mk-layout"><div class="mk-head"><div class="eyebrow">{eyebrow}</div><h2>{heading}</h2><p>{text}</p></div><div class="mk-cards">{countries.map(c=><a class="mk-card" href={'/locations/'+c.slug+'/'} data-country={c.slug}><span class={'flag flag-'+c.code} aria-hidden="true"></span><span class="mk-card-name">{c.name}</span><span class="mk-card-arrow" aria-hidden="true"><Icon name="arrow" size={18}/></span></a>)}</div><div class="mk-map"><svg class="map-svg" viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-label="Recruitment routes from India, Sri Lanka, Bangladesh, Nepal and the Philippines to Kuwait, Saudi Arabia, UAE, Qatar, Bahrain and Oman" xmlns="http://www.w3.org/2000/svg"><defs><clipPath id="map-gcc-clip"><rect width={map.split} height={map.height}/></clipPath><clipPath id="map-asia-clip"><rect x={map.split} width={map.width-map.split} height={map.height}/></clipPath><linearGradient id="map-fade-ramp" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000"/><stop offset=".1" stop-color="#fff"/></linearGradient><mask id="map-fade" maskUnits="userSpaceOnUse" x={map.split} y="0" width={map.width-map.split} height={map.height}><rect x={map.split} width={map.width-map.split} height={map.height} fill="url(#map-fade-ramp)"/></mask><marker id="map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="14" markerHeight="14" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#f5c04a"/></marker></defs>
<g clip-path="url(#map-asia-clip)"><g class="map-land" mask="url(#map-fade)">{map.asia.map(shape=><path d={shape.d} class={shape.kind?'is-'+shape.kind:undefined}/>)}</g></g>
<g clip-path="url(#map-gcc-clip)"><rect class="map-gcc-bg" width={map.split} height={map.height}/><g class="map-land">{map.gcc.map(shape=><path d={shape.d} class={shape.kind?'is-'+shape.kind:undefined}/>)}</g></g>
<line class="map-split" x1={map.split} y1="0" x2={map.split} y2={map.height}/>
<text class="map-cluster-label" x="190" y="58" text-anchor="middle" data-en="GCC" data-ar="الخليج">GCC</text>
<g class="map-lines">{sourceCountries.map((source,i)=>{const [x,y]=mapSources[source.slug];const [ex,ey,cx,cy]=routes[source.slug];return <path class="map-line" d={`M${x} ${y}Q${cx} ${cy} ${ex} ${ey}`} marker-end="url(#map-arrow)" style={`--i:${i}`}/>;})}</g>
{countries.map((c,i)=>{const [x,y]=mapPoints[c.slug];const l=destinationLabels[c.slug];return <a class="map-pin" href={'/locations/'+c.slug+'/'} data-country={c.slug} tabindex="-1" aria-hidden="true" style={`--i:${i}`}><circle class="map-hit" cx={x} cy={y} r="12"/><path class="map-dot" d={diamond(x,y,7)}/><text class="map-label" x={x+l.dx} y={y+l.dy} text-anchor={l.anchor} data-en={c.name} data-ar={mapArabic[c.slug]}>{c.name}</text></a>;})}
{sourceCountries.map(source=>{const [x,y]=mapSources[source.slug];return <g class="map-source"><circle class="map-source-ring" cx={x} cy={y} r="11"/><circle class="map-source-dot" cx={x} cy={y} r="5.5"/><text class="map-label map-label-source" x={x+source.dx} y={y+source.dy} text-anchor={source.anchor} data-en={source.name} data-ar={source.ar}>{source.name}</text></g>;})}
</svg>
<div class="mk-map-body"><ul class="map-legend"><li class="map-legend-source"><span class="map-key"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8" fill="none" stroke="#d9a520" stroke-opacity=".5"/><circle cx="9" cy="9" r="4" fill="#e9bd51"/></svg>Talent source countries</span><ul class="map-legend-flags">{sourceCountries.map(source=><li><img src={`/flags/${source.flag}.svg`} alt="" width="20" height="15" loading="lazy" decoding="async"/>{source.name}</li>)}</ul></li><li><span class="map-key"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3L15 9L9 15L3 9Z" fill="#fff" stroke="#d9a520" stroke-width="1.6"/></svg>GCC destinations</span></li></ul>
<div class="mk-lists"><div class="mk-list"><h3>Recruiting from</h3><ul class="mk-sources">{sourceCountries.map(source=><li><img src={`/flags/${source.flag}.svg`} alt="" width="24" height="18" loading="lazy" decoding="async"/>{source.name}</li>)}</ul></div><div class="mk-list mk-list-for"><h3>Recruiting for</h3><ul class="mk-sources">{countries.map(c=><li><a href={'/locations/'+c.slug+'/'}><span class={'flag flag-'+c.code} aria-hidden="true"></span>{c.name}</a></li>)}</ul></div></div><span class="map-caption">TALENT FROM FIVE COUNTRIES. OPPORTUNITIES ACROSS THE GCC.</span><p class="map-note">We recruit talent from India, Sri Lanka, Bangladesh, Nepal and the Philippines for employers across the GCC.</p>
</div></div></div><script>import '../scripts/markets';</script></section>
