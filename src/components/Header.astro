---
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import {services,industries} from '../data/site';
import {phoneDisplay} from '../data/contact';
const current=Astro.url.pathname;
const serviceIcons:Record<string,string>={'permanent-recruitment':'person','contract-project-staffing':'calendar','skilled-technical-manpower':'helmet','professional-specialist-recruitment':'badge','high-volume-recruitment':'users','executive-leadership-search':'leadership','recruitment-process-support':'workflow'};
const industryIcons:Record<string,string>={'engineering-technical':'tools','construction-infrastructure':'building','oil-gas-energy':'energy','manufacturing':'factory','hospitality':'hospitality','healthcare':'health','logistics-supply-chain':'truck','information-technology':'monitor','retail-ecommerce':'shop','banking-finance-corporate-services':'briefcase','facilities-management':'maintenance','education-professional-services':'book'};
const industryGroups=[
  {heading:'Energy & Industrial',slugs:['engineering-technical','construction-infrastructure','oil-gas-energy','manufacturing']},
  {heading:'Operations & Services',slugs:['logistics-supply-chain','facilities-management','hospitality','retail-ecommerce']},
  {heading:'Professional & Care',slugs:['healthcare','information-technology','banking-finance-corporate-services','education-professional-services']}
];
// Any industry not named above is appended to the last group so no link is ever dropped.
const grouped=new Set(industryGroups.flatMap(g=>g.slugs));
const ungrouped=industries.filter(i=>!grouped.has(i.slug)).map(i=>i.slug);
const industryColumns=industryGroups.map((g,n)=>({heading:g.heading,items:[...g.slugs,...(n===industryGroups.length-1?ungrouped:[])].map(slug=>industries.find(i=>i.slug===slug)!).filter(Boolean)}));
const featureImages:Record<string,string>={'oil-gas-energy':'/hero/hero-1-oil-gas-mobile.webp','construction-infrastructure':'/hero/hero-2-construction-mobile.webp','healthcare':'/hero/hero-3-healthcare-mobile.webp','logistics-supply-chain':'/hero/hero-4-logistics-mobile.webp','banking-finance-corporate-services':'/hero/hero-5-corporate-mobile.webp'};
const featureImage=(item:{slug:string;image:string})=>featureImages[item.slug]||`/images/${item.image}`;
const groups=[
  {label:'Services',route:'services',columns:[{heading:'',items:services}]},
  {label:'Industries',route:'industries',columns:industryColumns}
];
const flagCodes=['KW','SA','AE','QA','BH','OM'];
---
<div class="header-stack" id="header-stack"><div class="topbar"><div class="container topbar-inner"><a class="utility-email" href="mailto:info@adhunihr.com"><Icon name="mail" size={17}/><bdi dir="ltr">info@adhunihr.com</bdi></a>{phoneDisplay&&<span class="utility-message"><Icon name="phone" size={14}/><bdi dir="ltr">{phoneDisplay}</bdi><span aria-hidden="true">·</span><span>Response within one business day</span></span>}<div class="utility-actions"><SocialLinks/><div class="language-switch" role="group" aria-label="Choose language"><button type="button" data-language="en" lang="en" aria-pressed="true">English</button><span aria-hidden="true">/</span><button type="button" data-language="ar" lang="ar" aria-pressed="false">العربية</button></div></div></div></div>
<header class="site-header"><div class="container nav-inner"><Logo/><button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Open navigation"><Icon name="menu"/></button><nav id="primary-nav" aria-label="Main navigation">
<a href="/" class:list={[{active:current==='/'}]} aria-current={current==='/'?'page':undefined}>Home</a>
{groups.map(group=><details class:list={['nav-dropdown','catalog-dropdown',{'nav-current':current.startsWith('/'+group.route+'/')}]}><summary>{group.label}<Icon name="chevron" size={13}/></summary><div class:list={["dropdown-panel","catalog-menu",`catalog-menu--${group.route}`]}><div class="catalog-menu-body"><div class="catalog-menu-main"><div class="catalog-menu-top"><span>{group.label==='Services'?'RECRUITMENT SOLUTIONS':'INDUSTRIES WE SERVE'}</span><a href={`/${group.route}/`}>View all {group.label.toLowerCase()} →</a></div><div class="catalog-menu-links">{group.columns.map(col=><div class="catalog-group">{col.heading&&<p class="catalog-group-title">{col.heading}</p>}<div class="catalog-group-links">{col.items.map(item=><a class="catalog-link" href={`/${group.route}/${item.slug}/`} data-feature={item.slug} aria-current={current===`/${group.route}/${item.slug}/`?'page':undefined}><span class="catalog-item-icon"><Icon name={serviceIcons[item.slug] || industryIcons[item.slug] || "briefcase"} size={21}/></span><div class="catalog-item-copy"><strong>{item.title}<span class="catalog-item-arrow" aria-hidden="true"><Icon name="arrow" size={14}/></span></strong><span>{item.short}</span></div></a>)}</div></div>)}</div></div><aside class:list={['catalog-feature',`catalog-feature--${group.route}`]}>{group.route==='services'?<figure class="catalog-feature-media"><img src="/hero/hero-5-corporate-mobile.webp" alt="" width="900" height="506" loading="lazy" decoding="async"/></figure>:<div class="catalog-feature-media catalog-feature-stack">{industries.map(item=><figure class:list={['catalog-feature-slide',{'is-active':item.slug==='oil-gas-energy'}]} data-slug={item.slug}><img src={featureImage(item)} alt="" width="900" height="506" loading="lazy" decoding="async"/><figcaption>{item.title}</figcaption></figure>)}</div>}<div class="catalog-feature-copy"><p>{group.route==='services'?'Not sure which service fits? Talk to our team.':'Hiring in your sector? Talk to our team.'}</p><a class="button amber" href="/employers/#requirement">Discuss Your Hiring Needs <Icon name="arrow" size={18}/></a></div></aside></div><div class="catalog-menu-foot"><div class="catalog-menu-markets"><span class="catalog-flags" aria-hidden="true">{flagCodes.map(code=><span class={`flag flag-${code}`}></span>)}</span><span>Recruiting across Kuwait, Saudi Arabia, UAE, Qatar, Bahrain, Oman</span></div><a class="catalog-menu-cv" href="/candidates/"><span>Looking for a job?</span> <strong>Submit your CV</strong><Icon name="arrow" size={15}/></a></div></div></details>)}
{[{label:'Our Approach',href:'/our-approach/'},{label:'About',href:'/about/'},{label:'Contact',href:'/contact/'}].map(link=><a href={link.href} class:list={[{active:current===link.href}]} aria-current={current===link.href?'page':undefined}>{link.label}</a>)}
<a class="button navy nav-cta" href="/employers/#requirement">Request Candidates <span class="cta-arrow"><Icon name="arrow" size={22}/></span></a></nav></div></header></div>


