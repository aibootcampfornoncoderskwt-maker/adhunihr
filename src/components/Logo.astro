---
import BrandArtwork from './BrandArtwork.astro';
const {footer=false}=Astro.props;
---
<a href="/" class:list={['brand-logo',{ 'footer-logo':footer }]} aria-label="Adhuni HR Solutions home"><BrandArtwork reversed={footer}/>{!footer&&<BrandArtwork class="logo-art logo-art-light" reversed decorative filterId="header-logo-reverse"/>}</a>
