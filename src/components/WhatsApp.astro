---
import Icon from './Icon.astro';
import {whatsappUrl} from '../data/contact';
---
<aside class="whatsapp-widget" aria-label="WhatsApp contact"><div class="whatsapp-panel" id="whatsapp-panel" hidden><div class="wa-panel-head"><span class="wa-panel-icon"><Icon name="whatsapp" size={25}/></span><div><strong>Adhuni HR Solutions</strong><span>Let’s talk about your next step.</span></div><button type="button" class="wa-close" aria-label="Close WhatsApp panel"><Icon name="close" size={18}/></button></div><p>Tell us about your hiring needs or the role you’re looking for.</p>{whatsappUrl?<a class="wa-start" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Continue on WhatsApp <Icon name="arrow" size={18}/></a>:<><p class="wa-pending">WhatsApp contact will be available when the website launches.</p><a class="wa-start" href="/#contact">View enquiry options <Icon name="arrow" size={18}/></a></>}</div><button class="whatsapp-toggle" type="button" aria-label="Open WhatsApp contact" aria-expanded="false" aria-controls="whatsapp-panel"><span class="wa-tooltip">Let’s talk</span><Icon name="whatsapp" size={29}/></button></aside>
