---
import Icon from './Icon.astro';
import {whatsappNumber} from '../data/contact';
import {industries,services,countries} from '../data/site';
import arabic from '../data/arabic.json';
import clientArabic from '../data/client-arabic.json';
// The button opens WhatsApp with a message that matches the page. Hidden until a real number is configured.
const dictionary:Record<string,string>={...arabic,...clientArabic};
const ar=(text:string)=>dictionary[text]??text;
const path=Astro.url.pathname.replace(/\/$/,'');
const [section,slug]=path.split('/').filter(Boolean);
const industry=section==='industries'?industries.find(i=>i.slug===slug):undefined;
const service=section==='services'?services.find(s=>s.slug===slug):undefined;
const country=section==='locations'?countries.find(c=>c.slug===slug):undefined;
let pageType='general',en="Hi Adhuni, I'd like to discuss a hiring requirement.",arText='مرحباً أدهوني، أود مناقشة طلب توظيف.';
if(industry){pageType='industry';en=`Hi Adhuni, I'm interested in hiring for ${industry.title}.`;arText=`مرحباً أدهوني، أنا مهتم بالتوظيف في قطاع ${ar(industry.title)}.`;}
else if(service){pageType='service';en=`Hi Adhuni, I'd like to know more about ${service.title}.`;arText=`مرحباً أدهوني، أود معرفة المزيد عن ${ar(service.title)}.`;}
else if(country){pageType='country';en=`Hi Adhuni, I'm hiring in ${country.name}.`;arText=`مرحباً أدهوني، أنا أوظّف في ${ar(country.name)}.`;}
else if(path==='/candidates'){pageType='candidates';en="Hi Adhuni, I'd like to apply for a job.";arText='مرحباً أدهوني، أود التقدم لوظيفة.';}
const link=(text:string)=>`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
---
{whatsappNumber&&<aside class="whatsapp-widget" aria-label="WhatsApp contact"><a class="whatsapp-toggle" id="whatsapp-link" href={link(en)} data-href-en={link(en)} data-href-ar={link(arText)} data-page-type={pageType} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)"><span class="wa-tooltip">Let’s talk</span><Icon name="whatsapp" size={29}/></a></aside>}
<script>
import {track} from '../scripts/analytics';
// Pick the message language to match the site language, and keep it in step when the visitor switches.
const button=document.getElementById('whatsapp-link') as HTMLAnchorElement|null;
const sync=()=>{if(button)button.href=(document.documentElement.lang==='ar'?button.dataset.hrefAr:button.dataset.hrefEn)||button.href;};
sync();
new MutationObserver(sync).observe(document.documentElement,{attributes:true,attributeFilter:['lang']});
// Every WhatsApp link on the page reports its click with the type of page it was clicked on.
document.addEventListener('click',event=>{
 const link=(event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
 if(link)track('whatsapp_click',{page_type:button?.dataset.pageType||'general'});
});
</script>
