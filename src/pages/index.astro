---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import MarketsMap from '../components/MarketsMap.astro';
import AudienceCta from '../components/AudienceCta.astro';
import ServiceList from '../components/ServiceList.astro';
import {commitments} from '../data/commitments';
import IndustryCards from '../components/IndustryCards.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import {services,industries,countries} from '../data/site';
const featuredSectors=['engineering-technical','construction-infrastructure','oil-gas-energy','healthcare','logistics-supply-chain','information-technology'].map(slug=>industries.find(item=>item.slug===slug)!);
---
<Base>
<section class="hero" aria-labelledby="hero-title"><HeroSlideshow/><div class="container hero-inner"><div class="eyebrow light">MANPOWER SOURCING & RECRUITMENT</div><h1 id="hero-title">Skilled professionals for your business, <span>screened and ready to join.</span></h1><p class="hero-description">We find and screen candidates for technical, professional and project roles, then support you through documentation and joining, across the Middle East.</p><div class="hero-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/candidates/">Submit Your CV <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div><ul class="hero-facts"><li><strong>{industries.length} Industries</strong><span>Technical, professional and corporate roles</span></li><li><strong>{countries.length} Middle East Markets</strong><span>Kuwait, Saudi Arabia, UAE, Qatar, Bahrain, Oman</span></li><li><strong>Permanent & Project Hiring</strong><span>Long-term roles and project teams</span></li><li><strong>Brief to Joining</strong><span>Screening, documentation and joining support</span></li></ul></div></section>
<div class="country-ribbon" aria-label="Middle East markets"><div class="ribbon-label"><Icon name="globe" size={25}/><span>RECRUITING ACROSS<br/><strong>THE MIDDLE EAST</strong></span></div><div class="ribbon-viewport"><div class="ribbon-track">{[0,1].map(i=><div class="ribbon-group" aria-hidden={i===1?'true':undefined}>{countries.map(c=><span class="ribbon-market"><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}</span><b aria-hidden="true">✦</b></span>)}</div>)}</div></div></div>
<section id="about" class="section surface"><div class="container split about-grid"><div class="about-visual"><img class="section-image about-image" src="/images/interview.webp" alt="Illustrative recruitment discussion" width="1500" height="1000" loading="lazy"/><span class="about-caption">Every brief starts with a conversation.</span></div><div class="about-copy"><div class="eyebrow">ABOUT ADHUNI HR SOLUTIONS</div><h2>We take the search off your desk.</h2><p>Adhuni HR Solutions is a manpower sourcing and recruitment company for employers across the Middle East. We hire across {industries.length} industries, from skilled trades to corporate and leadership roles.</p><ul class="about-commitments">{commitments.map(c=><li><span class="about-commitment-icon"><Icon name={c.icon} size={20}/></span><div><strong>{c.title}</strong><span>{c.text}</span></div></li>)}</ul><a class="text-link catalog-overview-link about-link" href="/about/">Get to know Adhuni <Icon name="arrow" size={18}/></a></div></div></section>
<section id="services" class="section"><div class="container svc-layout"><div class="svc-intro"><div class="eyebrow">OUR SERVICES</div><h2>From one key hire to a full project team.</h2><p>Choose the service that fits your hiring plan, or tell us what you need and we'll recommend the right approach.</p><div class="svc-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="svc-all" href="/services/">Explore all services <Icon name="arrow" size={16}/></a></div><aside class="svc-help"><p>Not sure which service fits? Our team will recommend one.</p><a class="svc-help-link" href="/contact/">Contact us <Icon name="arrow" size={16}/></a></aside></div><ServiceList/></div></section>
<section id="industries" class="section surface ind"><div class="ind-inner"><div class="ind-head"><div class="eyebrow">INDUSTRIES WE SERVE</div><h2>Recruitment that knows your industry.</h2><p>We hire across {industries.length} industries, from site and plant roles to corporate offices. Choose yours to see the roles we fill.</p></div><IndustryCards slugs={['engineering-technical','construction-infrastructure','oil-gas-energy','healthcare','logistics-supply-chain','information-technology']}/><a class="ind-all" href="/industries/">Explore all {industries.length} industries <Icon name="arrow" size={16}/></a></div></section>
<section id="approach" class="section appr"><div class="appr-inner"><div class="appr-head"><div class="eyebrow light">OUR APPROACH</div><h2>From hiring brief to joining.</h2><p>One clear process, with one contact keeping you updated at every stage.</p></div><ApproachSteps/><div class="appr-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/our-approach/">See how our recruitment process works <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div></div></section>
<MarketsMap/>
<AudienceCta/>
</Base>

