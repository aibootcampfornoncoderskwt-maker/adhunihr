---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import {services,industries,countries} from '../data/site';
import mapRaw from '../../public/images/recruitment-map.svg?raw';
// The corridor map is the existing recruitment-map.svg, inlined so pins and labels can react to the country cards.
const mapStart = mapRaw.indexOf('<g clip-path="url(#clip)">') + '<g clip-path="url(#clip)">'.length;
const mapLand = mapRaw.slice(mapStart, mapRaw.search(/<path d="[^"]+" fill="none"/));
const mapLines = [...mapRaw.matchAll(/<path d="([^"]+)" fill="none"[^>]*stroke-dasharray/g)].map(m => m[1]);
const mapPins = [...mapRaw.matchAll(/<circle cx="([\d.]+)" cy="([\d.]+)" r="3"[^>]*\/><text x="([\d.]+)" y="([\d.]+)"/g)].map(m => ({cx: +m[1], cy: +m[2], tx: +m[3], ty: +m[4]}));
const indiaMatch = mapRaw.match(/<circle cx="([\d.]+)" cy="([\d.]+)" r="7"/)!;
const mapIndia = {cx: +indiaMatch[1], cy: +indiaMatch[2]};
const mapArabic: Record<string, string> = {kuwait: 'الكويت', 'saudi-arabia': 'السعودية', uae: 'الإمارات', qatar: 'قطر', oman: 'عُمان', bahrain: 'البحرين'};
const featuredSectors=['engineering-technical','construction-infrastructure','oil-gas-energy','healthcare','logistics-supply-chain','information-technology'].map(slug=>industries.find(item=>item.slug===slug)!);
const commitments=[{icon:'person',title:'One dedicated contact',text:'You work with one person who knows your brief.'},{icon:'search',title:'Screened before you see them',text:'We check experience, skills and documents before shortlisting.'},{icon:'workflow',title:'Support through to joining',text:'We coordinate interviews, documentation and joining dates.'}];
const sectorMedia:Record<string,{file:string;alt:string;roles:string[]}>={
 'engineering-technical':{file:'industry-engineering',alt:'Illustrative scene of an engineer in a hard hat and safety glasses inspecting an electrical control cabinet in an industrial plant.',roles:['Mechanical engineers','QA/QC inspectors','Electrical technicians']},
 'construction-infrastructure':{file:'industry-construction',alt:'Illustrative scene of a site supervisor directing workers laying reinforcement steel at a Gulf construction site at sunset.',roles:['Site engineers','Foremen','Skilled trades']},
 'oil-gas-energy':{file:'industry-oil-gas',alt:'Illustrative scene of an operator in coveralls and a hard hat walking along a pipe-rack walkway at a refinery at dusk.',roles:['Process operators','HSE officers','Maintenance technicians']},
 'healthcare':{file:'industry-healthcare',alt:'Illustrative scene of a laboratory technician in a white coat and hijab pipetting samples in a hospital laboratory.',roles:['Nurses','Lab technicians','Clinic administrators']},
 'logistics-supply-chain':{file:'industry-logistics',alt:'Illustrative scene of a forklift operator moving a wrapped pallet inside a warehouse.',roles:['Warehouse supervisors','Forklift operators','Procurement officers']},
 'information-technology':{file:'industry-it',alt:'Illustrative scene of an IT technician connecting network cables in a server rack.',roles:['Network engineers','IT support specialists','Systems administrators']}
};
const steps=[['Brief','We learn the role, skills, location and start date you need.'],['Search','We look for candidates who match your brief.'],['Screen','We check experience, skills and documents first.'],['Interview','We arrange interviews and collect your feedback.'],['Join','We coordinate offers, documentation and joining dates.']];
const summaries=['Long-term hires, screened for skills and fit.','Staff for fixed-term projects and assignments.','Engineers, technicians and skilled trades.','Finance, HR, admin and specialist business roles.','Many vacancies, filled through one coordinated process.','Confidential search for senior and leadership roles.','Help at any stage, from job brief to joining.'];
---
<Base>
<section class="hero" aria-labelledby="hero-title"><HeroSlideshow/><div class="container hero-inner"><div class="eyebrow light">MANPOWER SOURCING & RECRUITMENT</div><h1 id="hero-title">Skilled professionals for your business, <span>screened and ready to join.</span></h1><p class="hero-description">We find and screen candidates for technical, professional and project roles, then support you through documentation and joining, across the Middle East.</p><div class="hero-actions"><a class="button amber" href="/employers/#requirement">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/candidates/">Submit Your CV <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div><ul class="hero-facts"><li><strong>{industries.length} Industries</strong><span>Technical, professional and corporate roles</span></li><li><strong>{countries.length} Middle East Markets</strong><span>Kuwait, Saudi Arabia, UAE, Qatar, Bahrain, Oman</span></li><li><strong>Permanent & Project Hiring</strong><span>Long-term roles and project teams</span></li><li><strong>Brief to Joining</strong><span>Screening, documentation and joining support</span></li></ul></div></section>
<div class="country-ribbon" aria-label="Middle East markets"><div class="ribbon-label"><Icon name="globe" size={25}/><span>RECRUITING ACROSS<br/><strong>THE MIDDLE EAST</strong></span></div><div class="ribbon-viewport"><div class="ribbon-track">{[0,1].map(i=><div class="ribbon-group" aria-hidden={i===1?'true':undefined}>{countries.map(c=><span class="ribbon-market"><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}</span><b aria-hidden="true">✦</b></span>)}</div>)}</div></div></div>
<section id="about" class="section surface"><div class="container split about-grid"><div class="about-visual"><img class="section-image about-image" src="/images/interview.webp" alt="Illustrative recruitment discussion" width="1500" height="1000" loading="lazy"/><span class="about-caption">Every brief starts with a conversation.</span></div><div class="about-copy"><div class="eyebrow">ABOUT ADHUNI HR SOLUTIONS</div><h2>We take the search off your desk.</h2><p>Adhuni HR Solutions is a manpower sourcing and recruitment company for employers across the Middle East. We hire across {industries.length} industries, from skilled trades to corporate and leadership roles.</p><ul class="about-commitments">{commitments.map(c=><li><span class="about-commitment-icon"><Icon name={c.icon} size={20}/></span><div><strong>{c.title}</strong><span>{c.text}</span></div></li>)}</ul><a class="text-link catalog-overview-link about-link" href="/about/">Get to know Adhuni <Icon name="arrow" size={18}/></a></div></div></section>
<section id="services" class="section"><div class="container svc-layout"><div class="svc-intro"><div class="eyebrow">OUR SERVICES</div><h2>From one key hire to a full project team.</h2><p>Choose the service that fits your hiring plan, or tell us what you need and we'll recommend the right approach.</p><div class="svc-actions"><a class="button amber" href="/employers/#requirement">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="svc-all" href="/services/">Explore all services <Icon name="arrow" size={16}/></a></div><aside class="svc-help"><p>Not sure which service fits? Our team will recommend one.</p><a class="svc-help-link" href="/contact/">Contact us <Icon name="arrow" size={16}/></a></aside></div><ol class="svc-list">{services.map((s,i)=><li><a class="svc-row" href={'/services/'+s.slug+'/'}><span class="svc-num" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span class="svc-body"><h3>{s.title}</h3><p>{summaries[i]}</p></span><span class="svc-arrow" aria-hidden="true"><Icon name="arrow" size={20}/></span></a></li>)}</ol></div></section>
<section id="industries" class="section surface ind"><div class="ind-inner"><div class="ind-head"><div class="eyebrow">INDUSTRIES WE SERVE</div><h2>Recruitment that knows your industry.</h2><p>We hire across {industries.length} industries, from site and plant roles to corporate offices. Choose yours to see the roles we fill.</p></div><div class="ind-grid">{featuredSectors.map(item=><a class="ind-card" href={'/industries/'+item.slug+'/'}><img src={`/industries/${sectorMedia[item.slug].file}.webp`} srcset={`/industries/${sectorMedia[item.slug].file}-640.webp 640w, /industries/${sectorMedia[item.slug].file}.webp 1200w`} sizes="(max-width:600px) 100vw, (max-width:1000px) 50vw, 420px" alt={sectorMedia[item.slug].alt} width="1200" height="900" loading="lazy" decoding="async"/><div class="ind-overlay"><div class="ind-title"><h3>{item.title}</h3><span class="ind-arrow" aria-hidden="true"><Icon name="arrow" size={18}/></span></div><div class="ind-roles"><ul>{sectorMedia[item.slug].roles.map(role=><li>{role}</li>)}</ul></div></div></a>)}</div><a class="ind-all" href="/industries/">Explore all {industries.length} industries <Icon name="arrow" size={16}/></a></div></section>
<section id="approach" class="section appr"><div class="appr-inner"><div class="appr-head"><div class="eyebrow light">OUR APPROACH</div><h2>From hiring brief to joining.</h2><p>One clear process, with one contact keeping you updated at every stage.</p></div><ol class="appr-steps">{steps.map(([title,copy],i)=><li style={`--i:${i}`}><span class="appr-num">{String(i+1).padStart(2,'0')}</span><span class="appr-node" aria-hidden="true"></span><h3>{title}</h3><p>{copy}</p></li>)}</ol><div class="appr-actions"><a class="button amber" href="/employers/#requirement">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/our-approach/">See how our recruitment process works <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div></div></section>
<section id="markets" class="section surface mk"><div class="mk-layout"><div class="mk-head"><div class="eyebrow">WHERE WE RECRUIT</div><h2>One partner across six Middle East markets.</h2><p>Hiring in more than one country? Tell us where, and we'll plan the search around that country's requirements.</p></div><div class="mk-cards">{countries.map(c=><a class="mk-card" href={'/locations/'+c.slug+'/'} data-country={c.slug}><span class={'flag flag-'+c.code} aria-hidden="true"></span><span class="mk-card-name">{c.name}</span><span class="mk-card-arrow" aria-hidden="true"><Icon name="arrow" size={18}/></span></a>)}</div><div class="mk-map"><svg class="map-svg" viewBox="0 0 760 480" role="img" aria-label="Recruitment connections between India and Kuwait, Saudi Arabia, UAE, Qatar, Oman and Bahrain" xmlns="http://www.w3.org/2000/svg"><defs><clipPath id="map-clip"><rect width="760" height="480"/></clipPath></defs><g clip-path="url(#map-clip)"><g set:html={mapLand}/><g class="map-lines">{mapPins.map((pin,i)=><path class="map-line" d={mapLines[i]} data-country={countries[i].slug} style={`--i:${i}`}/>)}</g>{mapPins.map((pin,i)=><a class="map-pin" href={'/locations/'+countries[i].slug+'/'} data-country={countries[i].slug} tabindex="-1" aria-hidden="true" style={`--i:${i}`}><circle class="map-hit" cx={pin.cx} cy={pin.cy} r="16"/><circle class="map-pulse" cx={pin.cx} cy={pin.cy} r="3"/><circle class="map-dot" cx={pin.cx} cy={pin.cy} r="3"/><text class="map-label" x={pin.tx} y={pin.ty} data-en={countries[i].name} data-ar={mapArabic[countries[i].slug]}>{countries[i].name}</text></a>)}<circle class="map-india-dot" cx={mapIndia.cx} cy={mapIndia.cy} r="7"/><circle class="map-india-ring" cx={mapIndia.cx} cy={mapIndia.cy} r="13"/><text class="map-india-label" x={mapIndia.cx+17} y={mapIndia.cy+5} data-en="India" data-ar="الهند">India</text></g></svg><span class="map-caption">INDIA ↔ GCC RECRUITMENT CORRIDOR</span></div></div><script>import '../scripts/markets';</script></section>
<section id="contact" class="section cta"><div class="cta-grid"><div class="cta-employer"><div class="eyebrow">FOR EMPLOYERS</div><h2>Tell us who you need.</h2><p>Share the roles, experience and start date. We'll reply within one business day with a clear plan.</p><div class="cta-actions"><a class="button amber" href="/employers/#requirement">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><span class="cta-trust">No obligation · One dedicated contact</span></div><a class="text-link cta-contact" href="/contact/">Have a general enquiry? Contact us <Icon name="arrow" size={16}/></a></div><aside id="candidates" class="cta-candidate"><div class="eyebrow">FOR CANDIDATES</div><h3>Looking for your next role?</h3><p>Send us your CV. We'll contact you when a role matches your skills and experience.</p><div class="cta-actions"><a class="button cta-outline" href="/candidates/">Submit Your CV <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><span class="cta-note">PDF, DOC or DOCX · max 2 MB</span></div></aside></div></section>
</Base>

