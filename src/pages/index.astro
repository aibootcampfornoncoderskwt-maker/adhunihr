---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import {heroSlides,heroStaticPhrase,heroHeadingText,heroFixedLine} from '../data/hero-slides';
import MarketsMap from '../components/MarketsMap.astro';
import HealthcareSection from '../components/HealthcareSection.astro';
import AudienceCta from '../components/AudienceCta.astro';
import ServiceList from '../components/ServiceList.astro';
import {homeAboutCommitments} from '../data/commitments';
import '../styles/about-home.css';
import IndustryCards from '../components/IndustryCards.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import {services,industries,countries} from '../data/site';
const featuredSectors=['engineering-technical','construction-infrastructure','oil-gas-energy','healthcare','logistics-supply-chain','information-technology'].map(slug=>industries.find(item=>item.slug===slug)!);
---
<Base title="Healthcare & Oil and Gas Recruitment in the Middle East | Adhuni HR Solutions" description="Healthcare recruitment first: nurses, doctors and allied health. Then oil, gas and energy specialists. Across Kuwait, Saudi Arabia, UAE, Qatar, Bahrain and Oman.">
<section class="hero" aria-labelledby="hero-title"><HeroSlideshow/><div class="container hero-inner"><div class="eyebrow light">HEALTHCARE & ENERGY RECRUITMENT</div><h1 id="hero-title"><span class="hero-sr">{heroHeadingText}</span><span class="hero-title-visual" aria-hidden="true"><span class="hero-phrases">{heroSlides.map((slide,index)=><span class:list={['hero-phrase',{'is-active':index===0}]}>{slide.phrase}</span>)}<span class="hero-phrase hero-phrase-static">{heroStaticPhrase}</span></span><span class="hero-fixed">{heroFixedLine}</span></span></h1><p class="hero-description">Nurses, doctors and allied health staff for hospitals and clinics, plus specialist teams for oil, gas and energy, across the Middle East.</p><div class="hero-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/candidates/">Submit Your CV <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div><ul class="hero-facts"><li><strong>Healthcare first</strong><span>Nurses, doctors and allied health</span></li><li><strong>Oil, gas & energy</strong><span>Technical, HSE and operations roles</span></li><li><strong>{countries.length} Middle East markets</strong><span>Kuwait, Saudi Arabia, UAE, Qatar, Bahrain, Oman</span></li><li><strong>Brief to joining</strong><span>Screening, documentation and joining support</span></li></ul></div></section>
<div class="country-ribbon" aria-label="Middle East markets"><div class="ribbon-label"><Icon name="globe" size={25}/><span>RECRUITING ACROSS<br/><strong>THE MIDDLE EAST</strong></span></div><div class="ribbon-viewport"><div class="ribbon-track">{[0,1].map(i=><div class="ribbon-group" aria-hidden={i===1?'true':undefined}>{countries.map(c=><span class="ribbon-market"><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}</span><b aria-hidden="true">✦</b></span>)}</div>)}</div></div></div>
<HealthcareSection/>
<section id="about" class="section surface ab2"><div class="container ab2-grid"><figure class="ab2-media"><img src="/images/interview.webp" alt="Illustrative recruitment discussion" width="1500" height="1000" loading="lazy" decoding="async"/><figcaption class="ab2-badge">Every brief starts with a conversation.</figcaption></figure><div class="ab2-copy"><div class="ab2-top"><div class="eyebrow">ABOUT ADHUNI HR SOLUTIONS</div><h2>We take the search off your desk.</h2><p class="ab2-intro">Adhuni HR Solutions recruits for employers across the Middle East. Healthcare and oil &amp; gas are our specialist areas, and we also hire for engineering, construction, logistics and more.</p></div><ul class="ab2-list">{homeAboutCommitments.map(c=><li><span class="ab2-icon" aria-hidden="true"><Icon name={c.icon} size={20}/></span><div><strong>{c.title}</strong><span>{c.text}</span></div></li>)}</ul><a class="button secondary ab2-link" href="/about/">Get to know Adhuni <Icon name="arrow" size={16}/></a></div></div></section>
<section id="services" class="section"><div class="container svc-layout"><div class="svc-intro"><div class="eyebrow">OUR SERVICES</div><h2>From one key hire to a full project team.</h2><p>Choose the service that fits your hiring plan, or tell us what you need and we'll recommend the right approach.</p><div class="svc-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="svc-all" href="/services/">Explore all services <Icon name="arrow" size={16}/></a></div><aside class="svc-help"><p>Not sure which service fits? Our team will recommend one.</p><a class="svc-help-link" href="/contact/">Contact us <Icon name="arrow" size={16}/></a></aside></div><ServiceList/></div></section>
<section id="industries" class="section surface ind"><div class="ind-inner"><div class="ind-head"><div class="eyebrow">INDUSTRIES WE SERVE</div><h2>Recruitment that knows your industry.</h2><p>We hire across {industries.length} industries, from site and plant roles to corporate offices. Choose yours to see the roles we fill.</p></div><IndustryCards featured="healthcare" slugs={['healthcare','oil-gas-energy','engineering-technical','construction-infrastructure','logistics-supply-chain','information-technology','manufacturing']}/><a class="ind-all" href="/industries/">Explore all {industries.length} industries <Icon name="arrow" size={16}/></a></div></section>
<section id="approach" class="section appr"><div class="appr-inner"><div class="appr-head"><div class="eyebrow light">OUR APPROACH</div><h2>From hiring brief to joining.</h2><p>One clear process, with one contact keeping you updated at every stage.</p></div><ApproachSteps/><div class="appr-actions"><a class="button amber" href="/employers/#request-form">Request Candidates <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a><a class="button outline-light" href="/our-approach/">See how our recruitment process works <span class="btn-arrow"><Icon name="arrow" size={16}/></span></a></div></div></section>
<MarketsMap/>
<AudienceCta/>
</Base>

