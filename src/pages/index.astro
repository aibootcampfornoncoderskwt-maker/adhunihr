---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {services,industries,countries} from '../data/site';
const featuredSectors=['engineering-technical','construction-infrastructure','oil-gas-energy','healthcare','logistics-supply-chain','information-technology'].map(slug=>industries.find(item=>item.slug===slug)!);
const serviceIcons=['person','calendar','helmet','badge','users','leadership','workflow'];
const summaries=['Find suitable candidates for long-term appointments.','Plan recruitment around project phases and assignment duration.','Source engineers, technicians and skilled trades.','Recruit for specialist and business support functions.','Coordinate sourcing and screening for multiple vacancies.','Identify candidates for senior and leadership responsibilities.','Get support from the initial brief through to joining.'];
---
<Base>
<section class="hero" aria-labelledby="hero-title"><img class="hero-image" src="/images/hero-gcc.webp" alt="" width="1659" height="948" fetchpriority="high"/><div class="container hero-inner"><div class="eyebrow light">MANPOWER SOURCING & RECRUITMENT</div><h1 id="hero-title">Connecting Businesses<br/>with the <span>Right People.</span></h1><p class="hero-description">Recruitment support for specialist roles, project teams and larger workforce requirements, with a focus on the Middle East.</p><div class="hero-actions"><a class="button amber" href="/employers/#requirement">Discuss Your Hiring Needs <Icon name="arrow" size={18}/></a><a class="button outline-light" href="/candidates/">Submit Your CV <Icon name="arrow" size={18}/></a></div><ul class="hero-points"><li><Icon name="person" size={34}/><span>Specialist<br/>recruitment</span></li><li><Icon name="briefcase" size={34}/><span>Project hiring<br/>support</span></li><li><Icon name="globe" size={34}/><span>Middle East<br/>focus</span></li></ul><a href="#about" class="hero-scroll" aria-label="Explore the next section">↓</a></div></section>
<div class="country-ribbon" aria-label="India and GCC markets"><div class="ribbon-label"><Icon name="globe" size={25}/><span>CONNECTED<br/><strong>ACROSS THE GCC</strong></span></div><div class="ribbon-viewport"><div class="ribbon-track">{[0,1].map(i=><div class="ribbon-group" aria-hidden={i===1?'true':undefined}>{[...countries,{name:'India',code:'IN'}].map(c=><span class="ribbon-market"><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}</span><b aria-hidden="true">✦</b></span>)}</div>)}</div></div><button class="ribbon-control" aria-label="Pause country animation" aria-pressed="false">Ⅱ</button></div>
<section id="about" class="section surface"><div class="container split about-grid"><div class="about-visual"><img class="section-image about-image" src="/images/interview.webp" alt="Illustrative recruitment discussion" width="1500" height="1000" loading="lazy"/><span class="about-caption">People. Opportunities. Businesses.</span></div><div class="about-copy"><div class="eyebrow">ABOUT ADHUNI HR SOLUTIONS</div><h2>Your requirements. Our recruitment focus.</h2><p>Adhuni HR Solutions is a manpower sourcing and recruitment company serving employers across industries, with a strategic focus on the Middle East.</p><p>We clarify the role, source relevant candidates and coordinate screening, interviews and next steps around your requirements.</p><a class="text-link catalog-overview-link" href="/about/">Get to know Adhuni <Icon name="arrow" size={18}/></a></div></div></section>
<section id="services" class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">OUR SERVICES</div><h2>Support for the way you hire.</h2></div><p>From a single appointment to a project workforce, start with the support your business needs.</p></div><div class="home-service-grid">{services.map((s,i)=><a href={'/services/'+s.slug+'/'} class="home-service"><span class="home-service-icon"><Icon name={serviceIcons[i]} size={24}/></span><div><h3>{s.title}</h3><p>{summaries[i]}</p></div><Icon name="arrow" size={18}/></a>)}</div><a class="text-link catalog-overview-link" href="/services/">Explore all recruitment services <Icon name="arrow" size={18}/></a></div></section>
<section id="industries" class="section surface"><div class="container"><div class="section-heading"><div><div class="eyebrow">INDUSTRIES WE SERVE</div><h2>People for your sector.</h2></div><p>Define the experience, technical skills and working environment that matter to your team.</p></div><div class="home-sector-grid">{featuredSectors.map(item=><a class="home-sector" href={'/industries/'+item.slug+'/'}><img src={'/images/'+item.image} alt={item.alt} width="900" height="600" loading="lazy"/><div><h3>{item.title}</h3><Icon name="arrow" size={18}/></div></a>)}</div><a class="text-link catalog-overview-link" href="/industries/">Explore all 12 industries <Icon name="arrow" size={18}/></a></div></section>
<section id="approach" class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">OUR APPROACH</div><h2>From hiring brief to joining.</h2></div><p>Agree the criteria and responsibilities from the start, with communication through each stage.</p></div><ol class="home-process">{[['Understand','We clarify the role, experience, location and hiring timeline before sourcing begins.'],['Shortlist','We review candidate profiles against agreed criteria and coordinate employer interviews.'],['Coordinate','We follow up on selection, documentation and joining within the agreed recruitment scope.']].map(([title,copy],i)=><li><span>0{i+1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol><a class="text-link catalog-overview-link" href="/our-approach/">See how our recruitment process works <Icon name="arrow" size={18}/></a></div></section>
<section id="markets" class="section markets-section"><div class="container markets-grid"><div><div class="eyebrow light">MIDDLE EAST FOCUS</div><h2>Recruitment support across the GCC.</h2><p>Discuss your workforce needs across the GCC. Start with the destination, role requirements and expected joining date.</p><div class="market-links">{countries.map(c=><a href={'/locations/'+c.slug+'/'}><span class={'flag flag-'+c.code} aria-hidden="true"></span><span>{c.name}</span><span aria-hidden="true">↗</span></a>)}</div></div><div class="map-wrap"><img src="/images/recruitment-map.svg" alt="Recruitment connections between India and Kuwait, Saudi Arabia, UAE, Qatar, Oman and Bahrain" width="760" height="480" loading="lazy"/><span class="map-caption">INDIA ↔ GCC RECRUITMENT CORRIDOR</span></div></div></section>
<section id="contact" class="section home-next"><div class="container home-next-grid"><div class="home-employer"><div class="eyebrow">FOR EMPLOYERS</div><h2>Tell us who you need.</h2><p>Share your roles, required experience and hiring timeline. We’ll discuss the next steps for your recruitment brief.</p><div class="home-actions"><a class="button amber" href="/employers/#requirement">Submit Your Requirement <Icon name="arrow" size={18}/></a><a class="text-link home-contact-link" href="/contact/">Have a general enquiry? Contact us <Icon name="arrow" size={16}/></a></div></div><aside id="candidates" class="home-candidate"><div class="eyebrow">FOR CANDIDATES</div><h3>Explore your next opportunity.</h3><p>Share your CV and experience for consideration against suitable roles.</p><div class="home-actions"><a class="button white" href="/candidates/">Submit Your CV <Icon name="arrow" size={18}/></a></div></aside></div></section>
</Base>

