---
import Base from '../../layouts/Base.astro';
import {countries,services} from '../../data/site';
export function getStaticPaths(){return countries.map(country=>({params:{slug:country.slug},props:{country}}));}
const {country}=Astro.props;
---
<Base title={`Recruitment for ${country.name} | Adhuni HR Solutions`} description={`Discuss your ${country.name} hiring requirement with Adhuni HR Solutions. Recruitment conversations connecting employers with talent in India.`}><section class="detail-hero"><div class="container"><div class="breadcrumb"><a href="/">Home</a> / <a href="/#markets">Markets</a> / {country.name}</div><div class="eyebrow light">INDIA ↔ {country.name.toUpperCase()}</div><h1>{country.label}.</h1><p>{country.text}</p></div></section><section class="section"><div class="container detail-grid"><article class="detail-content"><h2>What does your team need?</h2><p>Adhuni’s recruitment focus includes employers hiring for {country.name}. Start with your requirement so we can discuss a suitable scope and selection process.</p><ul><li>Role titles, responsibilities and required experience</li><li>Work location and working conditions</li><li>Proposed employment terms and number of positions</li><li>Interview availability and preferred joining dates</li></ul><a href={`/employers/?country=${encodeURIComponent(country.name)}#requirement`} data-market-enquiry class="button navy">Discuss hiring in {country.name} ↗</a></article><aside class="detail-aside"><h3>Before recruitment begins</h3><p>Confirm the employing entity, selection criteria and responsibilities for documentation and joining. Requirements vary by role and engagement.</p><p class="small-note">This page describes a market focus, not a claim of a local office or regulatory authorisation. Confirm the applicable arrangement with the team.</p></aside></div></section><section class="section surface"><div class="container"><h2>Choose the conversation that fits.</h2><div class="detail-cards">{services.slice(0,3).map(s=><a href={`/services/${s.slug}/`}><h3>{s.title}</h3><p>{s.short}</p></a>)}</div></div></section></Base>
