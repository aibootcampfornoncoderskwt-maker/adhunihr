---
import Crm from '../../layouts/Crm.astro';
import {hasSession,crmHeaders} from '../../lib/crm/guard';
import fields from '../../data/enquiry-fields.json';
export const prerender=false;
if(!(await hasSession(Astro.request)))return Astro.redirect('/crm/login');
Object.entries(crmHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const options={countries:(fields.candidate.find(f=>f.name==='country') as any)?.options??[],categories:(fields.candidate.find(f=>f.name==='job_category') as any)?.options??[],categoryLabel:'Job category'};
---
<Crm title="Candidates" view="candidates" type="candidate" options={options}></Crm>
