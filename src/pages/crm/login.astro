---
import Crm from '../../layouts/Crm.astro';
import {hasSession,crmHeaders} from '../../lib/crm/guard';
import {loginConfigured} from '../../lib/crm/auth';
export const prerender=false;
if(await hasSession(Astro.request))return Astro.redirect('/crm/');
Object.entries(crmHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const expired=Astro.url.searchParams.has('expired');
const ready=loginConfigured();
---
<Crm title="Sign in" view="login" bare>
<main class="crm-login">
<form class="crm-login-card" data-login novalidate>
<img src="/images/adhuni-approved.webp" alt="Adhuni HR Solutions" width="180" height="92"/>
<h1>CRM sign in</h1>
<p class="crm-login-note">For Adhuni HR Solutions staff only.</p>
{expired&&<p class="crm-alert" role="status">Your session ended. Please sign in again.</p>}
{!ready&&<p class="crm-alert crm-alert-error" role="status">The CRM login is not set up yet. In Vercel, CRM_ADMIN_PASSWORD_HASH must hold the <code>scrypt$…</code> line printed by <code>node scripts/crm-hash-password.mjs</code> (not the password itself), then redeploy.</p>}
<label>Username<input name="username" autocomplete="username" required value="admin" spellcheck="false" autocapitalize="off"/></label>
<div class="crm-field"><label for="crm-password">Password</label><div class="crm-pass"><input id="crm-password" name="password" type="password" autocomplete="current-password" required/><button type="button" class="crm-pass-toggle" data-pass-toggle aria-controls="crm-password" aria-pressed="false" aria-label="Show password" title="Show password"><svg class="crm-eye" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="crm-eye-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M10.6 5.1A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6A17.4 17.4 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></div></div>
<button type="submit" class="crm-btn crm-btn-primary" disabled={!ready}>Sign in</button>
<p class="crm-login-error" role="alert" aria-live="assertive"></p>
</form>
</main>
</Crm>
