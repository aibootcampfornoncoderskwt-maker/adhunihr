---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PageQuestions from '../components/PageQuestions.astro';
import AudienceCta from '../components/AudienceCta.astro';
import {approachSteps,approachQuestions,requestCandidatesHref} from '../data/approach';
import '../styles/approach.css';
const checklist=['Company / organisation name','Job title and number of vacancies','Qualifications and experience','Mandatory certifications or licences','Work location and expected joining date','Salary / compensation and benefits'];
// FAQPage schema describes only the questions that are visible on the page.
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':new URL(Astro.url.pathname,Astro.site).href+'#faq',mainEntity:approachQuestions.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<Base title="Our Recruitment Approach & Process | Adhuni HR Solutions" description="See how Adhuni recruits in five steps, from hiring brief and candidate search to screening, interviews and joining, with one contact keeping you updated." image="/pages/approach-hero.webp" breadcrumbs={[{name:'Our Approach',href:'/our-approach/'}]}>
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g,'\\u003c')}/></Fragment>
<PageHero variant="ap-hero" eyebrow="OUR APPROACH" crumb="Our Approach" title="From hiring brief to joining." description="One clear process, with one contact keeping you updated at every stage." image="/pages/approach-hero.webp" alt="Illustrative scene of three colleagues planning a process on a whiteboard flowchart in a bright office." caption="" cta={{label:'Request Candidates',href:requestCandidatesHref,arrow:'→'}}/>
<section class="section"><div class="container page-editorial"><div><div class="eyebrow">REQUIREMENT-DRIVEN RECRUITMENT</div><h2>Understand the work before the search.</h2></div><div class="page-prose"><p class="lead">We don't start by matching CVs. We start by understanding the role: the skills, location, salary range and start date. That brief guides every step that follows.</p></div></div></section>
<section id="process" class="section ap-process"><div class="container"><div class="ap-head"><div class="eyebrow light">OUR PROCESS</div><h2>Who does what at each step.</h2></div><ol class="ap-steps">{approachSteps.map((step,i)=><li style={`--i:${i}`}><span class="ap-num">{String(i+1).padStart(2,'0')}</span><span class="ap-node" aria-hidden="true"></span><div class="ap-body"><h3>{step.title}</h3><dl class="ap-cols"><div class="ap-col ap-we"><dt>We do</dt><dd>{step.we}</dd></div><div class="ap-col"><dt>You do</dt><dd>{step.you}</dd></div></dl></div></li>)}</ol></div></section>
<section class="section"><div class="container page-two-col"><div><div class="eyebrow">A USEFUL FIRST BRIEF</div><h2>What we need from you.</h2><p class="section-intro">The more clearly the requirement is defined, the more accurately we can source.</p><ul class="page-role-list">{checklist.map((point,index)=><li><span aria-hidden="true">0{index+1}</span><strong>{point}</strong></li>)}</ul><a href={requestCandidatesHref} class="button amber ap-button">Request Candidates <span class="ap-arrow" aria-hidden="true">→</span></a></div><aside class="page-brief"><div class="eyebrow">CLEAR RESPONSIBILITIES</div><h2>Know the next step.</h2><p>Once we have your brief, we confirm the plan, the timeline and who reviews candidates. Urgent role? Tell us in your first message and we'll plan around it.</p><div class="client-actions"><a href="/candidates/#how-it-works" class="text-link">See the candidate journey →</a></div></aside></div></section>
<section class="section surface"><div class="container faq-wrap"><div><div class="eyebrow">QUESTIONS &amp; ANSWERS</div><h2>Clarity at every stage.</h2></div><PageQuestions questions={approachQuestions}/></div></section>
<AudienceCta id="start"/>
<script>import '../scripts/approach-timeline';</script>
</Base>
