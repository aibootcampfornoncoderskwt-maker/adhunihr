---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ImageCredit from '../../components/ImageCredit.astro';
import {industries} from '../../data/site';
import {industryPhoto,sectorMedia} from '../../data/sector-media';
---
<Base title="Industries We Recruit For | Adhuni HR Solutions" description="Explore recruitment across twelve industries, including engineering, construction, energy, healthcare, logistics, technology, finance and education." breadcrumbs={[{name:'Industries',href:'/industries/'}]}>
<PageHero eyebrow="Industries" title="One recruitment partner. Twelve industry perspectives." description="Our recruitment model is designed to support employers across a broad range of industries. Explore the roles, working environments and hiring details that matter in your sector." cta={{label:'Discuss your industry',href:'/employers/#request-form'}}/>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">INDUSTRIES WE SERVE</div><h2>Start with your sector.</h2></div><p>Each industry has its own responsibilities, skills and working context.</p></div><div class="catalog-cards">{industries.map(industry=><a class="catalog-card" href={`/industries/${industry.slug}/`}><img src={industryPhoto[industry.slug]?`/industries/${industryPhoto[industry.slug]}.webp`:`/images/${industry.image}`} alt={industryPhoto[industry.slug]?sectorMedia[industry.slug].alt:industry.alt} width={industryPhoto[industry.slug]?1200:1536} height={industryPhoto[industry.slug]?900:1024} loading="lazy"/><div><h2>{industry.title}</h2><p>{industry.description}</p><span class="text-link">Explore industry →</span></div></a>)}</div><p class="small-note">Role examples are provided for recruitment discussions and are not advertised vacancies.</p><div class="catalog-credits">{['industrial.webp','sector-oil-gas.webp','hospitality.webp'].map(image=><ImageCredit image={image}/>)}</div></div></section>
<section class="section surface"><div class="container page-end-cta"><div><h2>Have a requirement across several sectors?</h2><p>Share each role and its responsibilities so we can discuss a coordinated recruitment approach.</p></div><a class="button navy" href="/employers/#request-form">Request Candidates →</a></div></section>
</Base>
