---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import MarketsMap from '../components/MarketsMap.astro';
import AudienceCta from '../components/AudienceCta.astro';
import {industries,countries,services} from '../data/site';
import {aboutConfig} from '../data/about';
import '../styles/about.css';

const {founded,headOffice,story,founder,leadership}=aboutConfig;
const showQuote=Boolean(founder.quote&&founder.name);
const facts=[
  founded&&{value:founded,label:'Founded'},
  headOffice&&{value:headOffice,label:'Head office'},
  {value:String(industries.length),label:'industries'},
  {value:String(countries.length),label:'Middle East markets'},
  {value:String(services.length),label:'recruitment services'},
  {value:'5-step',label:'hiring process'}
].filter(Boolean) as {value:string;label:string}[];
const principles=[
  {icon:'message',title:'Honest updates',text:"We tell you what's working and what isn't, at every stage."},
  {icon:'search',title:'Screened shortlists',text:"You only see candidates we've checked against your brief."},
  {icon:'person',title:'One point of contact',text:'The same person handles your brief from start to finish.'},
  {icon:'calendar',title:'Agreed timelines',text:'We set milestones at the start and keep you informed against them.'},
  {icon:'lock',title:'Confidential by default',text:'Client and candidate information stays private.'},
  {icon:'users',title:'Long-term thinking',text:'We measure success by hires who stay, not CVs sent.'}
];
const initials=(name:string)=>name.split(/\s+/).filter(Boolean).slice(0,2).map(part=>part[0]).join('').toUpperCase();
---
<Base title="About Adhuni | Adhuni HR Solutions" description="Adhuni HR Solutions is a recruitment company for Middle East employers. We understand the role first, then find people who fit it." image="/pages/about-hero.webp" pageType="AboutPage" breadcrumbs={[{name:'About',href:'/about/'}]}>
<PageHero variant="ab-hero" eyebrow="ABOUT ADHUNI" crumb="About" title="Built to make hiring simpler for Middle East employers." description="Adhuni HR Solutions is a recruitment company with a simple idea: understand the role first, then find people who fit it." image="/pages/about-hero.webp" alt="Illustrative scene of four business professionals walking through a bright office corridor with a Kuwait City waterfront view." caption="" cta={{label:'Request Candidates',href:'/employers/#request-form',arrow:'→'}}/>

<section class="section ab-story" aria-labelledby="ab-story-title"><div class="container ab-story-grid">
  <figure class="ab-story-media"><img src="/pages/about-story.webp" width="1200" height="751" alt="Illustrative close-up of a recruiter reviewing printed CVs at a desk with a pen, notebook and laptop." loading="lazy"/></figure>
  <div class="ab-story-copy">
    <div class="eyebrow">OUR STORY</div>
    <h2 id="ab-story-title">We start with the role.</h2>
    {story.map(paragraph=><p>{paragraph}</p>)}
    {showQuote&&<figure class="ab-quote"><blockquote><p>{founder.quote}</p></blockquote><figcaption><strong>{founder.name}</strong>{founder.role&&<span>{founder.role}</span>}</figcaption></figure>}
  </div>
</div></section>

<section class="ab-facts" aria-label="Adhuni at a glance"><div class="container"><ul class="ab-facts-list" style={`--n:${facts.length}`}>{facts.map(fact=><li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}</ul></div></section>

{leadership.length>0&&<section class="section ab-leaders" aria-labelledby="ab-leaders-title"><div class="container"><div class="eyebrow">LEADERSHIP</div><h2 id="ab-leaders-title">The people behind Adhuni.</h2><ul class="ab-leader-grid">{leadership.map(person=><li class="ab-leader">{person.photo?<img src={person.photo} alt={person.name} width="480" height="480" loading="lazy"/>:<span class="ab-leader-initials" aria-hidden="true">{initials(person.name)}</span>}<h3>{person.name}</h3><p>{person.role}</p>{person.linkedin&&<a class="text-link" href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>LinkedIn <Icon name="arrow" size={16}/></a>}</li>)}</ul></div></section>}

<section class="section surface ab-direction"><div class="container ab-direction-grid">
  <div class="ab-statement"><div class="eyebrow">OUR VISION</div><h2>To be the recruitment partner Middle East employers call first.</h2></div>
  <div class="ab-statement"><div class="eyebrow">OUR MISSION</div><h2>To give every client one responsive contact, properly screened candidates, and support until they join.</h2></div>
</div></section>

<section class="section ab-principles" aria-labelledby="ab-principles-title"><div class="container">
  <div class="ab-principles-head"><div class="eyebrow">HOW WE WORK</div><h2 id="ab-principles-title">What you can expect from us.</h2></div>
  <ul class="ab-principle-grid">{principles.map(item=><li><span class="ab-principle-icon" aria-hidden="true"><Icon name={item.icon} size={22}/></span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ul>
</div></section>

<MarketsMap eyebrow="WHERE WE WORK" heading="One team across six Middle East markets."/>
<AudienceCta/>
</Base>
