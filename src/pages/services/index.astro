---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ServiceList from '../../components/ServiceList.astro';
import ApproachSteps from '../../components/ApproachSteps.astro';
import PageQuestions from '../../components/PageQuestions.astro';
import AudienceCta from '../../components/AudienceCta.astro';
import {services,industries} from '../../data/site';
import {groupIndustries} from '../../data/industry-groups';
import '../../styles/service.css';
import '../../styles/services-overview.css';

const numberWord=['Zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten'][services.length]??String(services.length);
// "Which service fits?" cards: a situation, the service that suits it, and a link to that service page.
const situations=[
  {text:'Filling an ongoing role',slug:'permanent-recruitment'},
  {text:'Staffing a project for a fixed period',slug:'contract-project-staffing'},
  {text:'Hiring many people at once',slug:'high-volume-recruitment'},
  {text:'Hiring a senior leader',slug:'executive-leadership-search'}
].flatMap(item=>{const service=services.find(s=>s.slug===item.slug);return service?[{text:item.text,service}]:[];});
const industryColumns=groupIndustries(industries);
const questions:string[][]=[
  ['Can you recruit for more than one industry?',`Yes. We hire across ${industries.length} industries, and one brief can cover roles in different areas.`],
  ['Do you provide both skilled and professional manpower?','Yes. From technicians and trades to finance, HR and leadership roles.'],
  ['Can you handle large recruitment requirements?','Yes. Our high-volume service plans the search in phases, so priority roles are filled first.'],
  ['How long does recruitment take?','It depends on the role and the number of vacancies. We agree a realistic timeline with you after the brief.']
];
// Structured data: a CollectionPage whose main entity lists the services, plus FAQPage for the visible questions only.
const base=new URL('/',Astro.site).href;
const serviceList={'@type':'ItemList',name:'Recruitment services',itemListElement:services.map((s,i)=>({'@type':'ListItem',position:i+1,name:s.title,url:`${base}services/${s.slug}/`}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':new URL(Astro.url.pathname,Astro.site).href+'#faq',mainEntity:questions.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<Base title="Recruitment Services | Adhuni HR Solutions" description="Seven recruitment services for Middle East employers: permanent hiring, project staffing, technical manpower, specialist recruitment, high-volume hiring, leadership search and process support." image="/pages/services-hero.webp" pageType="CollectionPage" mainEntity={serviceList} breadcrumbs={[{name:'Services',href:'/services/'}]}>
<PageHero variant="svo-hero" eyebrow="SERVICES" crumb="Services" title="From one key hire to a full project team." description="Choose the service that fits your hiring plan, or tell us what you need and we'll recommend the right approach." image="/pages/services-hero.webp" alt="Illustrative scene of a busy open-plan recruitment office with colleagues working at desks and a city skyline beyond." caption="" cta={{label:'Request Candidates',href:'/employers/#request-form',arrow:'→'}}/>

<section id="which-service" class="section svo-fit" aria-labelledby="svo-fit-title"><div class="container">
  <div class="svo-head"><div class="eyebrow">WHICH SERVICE FITS?</div><h2 id="svo-fit-title">Start with your situation.</h2></div>
  <ul class="svo-fit-grid">{situations.map(({text,service})=><li><a class="svo-fit-card" href={`/services/${service.slug}/`}><span class="svo-fit-situation">{text}</span><span class="svo-fit-service"><span>{service.title}</span><Icon name="arrow" size={18}/></span></a></li>)}</ul>
  <p class="svo-fit-more"><span>Something else?</span> <a class="text-link" href="/contact/">Tell us what you need <Icon name="arrow" size={16}/></a></p>
</div></section>

<section id="all-services" class="section surface svo-all"><div class="container svc-layout">
  <div class="svc-intro"><div class="eyebrow">ALL SERVICES</div><h2>{numberWord} services for different hiring needs.</h2><p>Each service has its own page with scope, a hiring brief checklist and answers to common questions.</p></div>
  <ServiceList/>
</div></section>

<section id="how-it-works" class="section appr appr--compact"><div class="appr-inner"><div class="appr-head"><div class="eyebrow light">HOW IT WORKS</div><h2>From brief to joining in five steps.</h2></div><ApproachSteps/><a class="sv-approach-link" href="/our-approach/">See our full approach <Icon name="arrow" size={16}/></a></div></section>

<section id="industry-list" class="section svo-ind"><div class="container">
  <div class="eyebrow">INDUSTRIES</div><h2>Multi-industry by design.</h2>
  <div class="svo-ind-grid">{industryColumns.map(column=><div class="svo-ind-col"><h3>{column.heading}</h3><ul>{column.items.map(industry=><li><a href={`/industries/${industry.slug}/`}><span>{industry.title}</span><Icon name="arrow" size={16}/></a></li>)}</ul></div>)}</div>
</div></section>

<section id="questions" class="section surface"><div class="container faq-wrap"><div><div class="eyebrow">PRACTICAL ANSWERS</div><h2>Common questions.</h2></div><PageQuestions questions={questions}/></div></section>

<AudienceCta/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
</Base>
