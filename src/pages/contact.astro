---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Contact from '../components/Contact.astro';
import ImageCredit from '../components/ImageCredit.astro';
---
<Base title="Contact Adhuni HR Solutions | Recruitment Enquiries" description="Contact Adhuni HR Solutions for employer requirements, candidate enquiries and recruitment discussions across industries and GCC markets." image="/images/meeting.webp" pageType="ContactPage" breadcrumbs={[{name:'Contact',href:'/contact/'}]}>
<PageHero eyebrow="Contact" title="Let’s Start a Conversation." description="Whether you are looking for the right people for your business or exploring your next career opportunity, our team is ready to hear from you." image="meeting.webp" alt="Professionals discussing a recruitment requirement" cta={{label:'Send an enquiry',href:'#general-enquiry'}}/>
<Contact showHeading={false}/>
<section class="section"><div class="container page-editorial"><div><div class="eyebrow">CONTACT DETAILS</div><h2>Ready when you are.</h2><a class="text-link" href="mailto:info@adhunihr.com">info@adhunihr.com</a></div><div class="page-prose"><p>For an employer requirement, share the job title, number of vacancies, required experience, work location and expected joining date. Candidates can use the dedicated registration page to submit a CV and career details.</p><div class="client-actions"><a href="/employers/#requirement" class="button navy">For Employers →</a><a href="/candidates/#registration" class="button amber">For Candidates →</a></div><ImageCredit image="meeting.webp"/></div></div></section>
</Base>
