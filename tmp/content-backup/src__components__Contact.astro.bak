---
import {countries,services} from '../data/site';
const enabled=import.meta.env.PUBLIC_CONTACT_ENABLED==='true';
const key=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<section id="contact" class="section contact-section"><div class="container contact-wrap"><div class="contact-intro"><div class="eyebrow light">LET’S TALK ABOUT THE WORK AHEAD</div><h2>The next step<br/>starts with you.</h2><p>Hiring a team or looking for your next role? Share the essentials and start a focused conversation.</p><div class="contact-prep"><span>WHAT TO INCLUDE</span><h3>A useful first message.</h3><ul><li>The role and relevant experience</li><li>Your preferred GCC market</li><li>Hiring quantities or career priorities</li><li>Your expected timing</li></ul></div><div class="contact-markets">Kuwait · Saudi Arabia · UAE<br/>Qatar · Oman · Bahrain</div></div><div class="contact-workspace"><h3>Tell us what you have in mind.</h3><div class="tabs contact-tabs" role="tablist" aria-label="Enquiry type"><button id="employer-tab" role="tab" aria-selected="true" aria-controls="employer-panel" data-contact-tab="employer">I’m hiring</button><button id="candidate-tab" role="tab" aria-selected="false" aria-controls="candidate-panel" tabindex="-1" data-contact-tab="candidate">I’m looking for work</button></div>
{['employer','candidate'].map(type=><div id={`${type}-panel`} role="tabpanel" aria-labelledby={`${type}-tab`} hidden={type!=='employer'}><form class="contact-form" data-contact-form data-enabled={String(enabled)}><input type="hidden" name="type" value={type}/><div class="form-grid"><label>Your name<input name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Full name"/></label><label>{type==='employer'?'Company':'Current role'}<input name="company" autocomplete={type==='employer'?'organization':'organization-title'} required maxlength="160" placeholder={type==='employer'?'Company name':'Your role or specialisation'}/></label><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="254" placeholder="you@company.com"/></label>{type==='employer' && <label>Recruitment service <span>(optional)</span><select name="service"><option value="">Help me choose</option>{services.map(s=><option value={s.slug}>{s.title}</option>)}</select></label>}<label>Phone <span>(optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="40" placeholder="Include country code"/></label><label>{type==='employer'?'Hiring location':'Preferred location'}<select name="country" required><option value="">Select a country</option>{countries.map(c=><option>{c.name}</option>)}<option>India</option><option>To be discussed</option></select></label><label>{type==='employer'?'Number of positions':'Years of experience'}<select name="scope" required><option value="">Select an option</option>{(type==='employer'?['1–5','6–20','21–50','50+','To be discussed']:['0–2 years','3–5 years','6–10 years','10+ years']).map(n=><option>{n}</option>)}</select></label><label class="full">{type==='employer'?'Tell us about the roles':'Tell us about your experience'}<textarea name="message" required minlength="20" maxlength="4000" rows="4" placeholder={type==='employer'?'Roles, essential skills, work location and preferred joining dates.':'Your skills, recent experience and the type of work you are looking for.'}></textarea></label><label class="consent full"><input type="checkbox" name="consent" required/><span>I agree to be contacted about this enquiry and have read the <a href="/privacy/">privacy notice</a>.</span></label><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div></div>{enabled && key && <div class="cf-turnstile" data-sitekey={key}></div>}<button class="button navy submit-button" type="submit">{type==='employer'?'Discuss my hiring needs':'Send my career enquiry'} <span aria-hidden="true">↗</span></button><p class="form-status" role="status" aria-live="polite"></p>{!enabled && <p class="form-note">Enquiries are not being collected on this preview. The form will be available when the website launches.</p>}<p class="form-note">Please do not include passport numbers, identity documents or sensitive personal information.</p></form></div>)}
</div></div></section>
{enabled && key && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
