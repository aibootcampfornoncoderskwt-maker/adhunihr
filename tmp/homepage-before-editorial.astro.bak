---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import ClientCopy from '../components/ClientCopy.astro';
import ClientFAQ from '../components/ClientFAQ.astro';
import client from '../data/client-content.json';
import {services,industries,countries,pipelines} from '../data/site';

---
<Base>
<section class="hero" aria-labelledby="hero-title"><img class="hero-image" src="/images/hero-gcc.webp" alt="" width="1659" height="948" fetchpriority="high"/><div class="container hero-inner"><div class="eyebrow light">RECRUITMENT ACROSS ALL SIX GCC MARKETS</div><h1 id="hero-title">Connecting Businesses<br/>with the <span>Right People.</span></h1><p class="hero-description">Reliable manpower sourcing and recruitment solutions for businesses across industries, with a strong focus on the Middle East.</p><div class="hero-actions"><a class="button amber" href="/employers/#requirement">Find the Right Talent <Icon name="arrow" size={18}/></a><a class="button outline-light" href="/candidates/"><Icon name="person" size={22}/> Submit Your CV</a></div><ul class="hero-points"><li><Icon name="person" size={34}/><span>Specialist<br/>recruitment</span></li><li><Icon name="briefcase" size={34}/><span>Project hiring<br/>support</span></li><li><Icon name="globe" size={34}/><span>India–GCC<br/>coverage</span></li></ul><a href="#about" class="hero-scroll" aria-label="Explore the next section">↓</a></div></section>
<div class="country-ribbon" aria-label="India and GCC markets"><div class="ribbon-label"><Icon name="globe" size={25}/><span>CONNECTED<br/><strong>ACROSS THE GCC</strong></span></div><div class="ribbon-viewport"><div class="ribbon-track">{[0,1].map(i=><div class="ribbon-group" aria-hidden={i===1?'true':undefined}>{[...countries,{name:'India',code:'IN'}].map(c=><span class="ribbon-market"><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}</span><b aria-hidden="true">✦</b></span>)}</div>)}</div></div><button class="ribbon-control" aria-label="Pause country animation" aria-pressed="false">Ⅱ</button></div>
<section id="about" class="section surface"><div class="container split about-grid"><div class="about-visual"><img class="section-image about-image" src="/images/interview.webp" alt="Recruitment discussion" width="1500" height="1000" loading="lazy"/><span class="about-caption">People. Opportunities. Businesses.</span></div><div class="about-copy"><div class="eyebrow">WHO WE ARE</div><ClientCopy text={client.Home['Who we are']}/><a class="button navy" href="/about/">Learn About Us →</a></div></div></section>
<section id="services" class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">RECRUITMENT, BUILT AROUND YOUR REQUIREMENT</div><h2>Flexible recruitment solutions.</h2></div><p>Tailored according to the role, workforce size, location, experience level and hiring timeline.</p></div><div class="service-rows">{services.map((s,i)=><a class="service-row" href={`/services/${s.slug}/`}><span class="service-index">0{i+1}</span><div class="service-name"><span class="service-kicker">{s.short}</span><h3>{s.title}</h3></div><div class="service-summary"><p>{s.description}</p><span class="text-link">Explore this service</span></div><span class="service-arrow"><Icon name="arrow" size={22}/></span></a>)}</div><a class="text-link catalog-overview-link" href="/services/">Explore all recruitment services →</a><div class="inline-banner"><span>Not sure which service fits your requirement?</span><a href="#contact">Let’s work it out together <Icon name="arrow" size={18}/></a></div></div></section>
<section id="industries" class="section surface industry-section"><div class="container"><div class="section-heading"><div><div class="eyebrow">SECTOR UNDERSTANDING MATTERS</div><h2>One recruitment partner.<br/>Multiple sectors.</h2></div><p>Our recruitment model is designed to support employers across a broad range of industries.</p></div><div class="sector-mosaic">{industries.map((item,i)=><a href={`/industries/${item.slug}/`} class:list={['sector-tile',{'sector-featured':i<2}]}><img src={`/images/${item.image}`} alt={`${item.title} working environment`} width="900" height="600" loading="lazy"/><div class="sector-copy"><h3>{item.title}</h3><p>{item.roles.slice(0,3).join(', ')}.</p><span class="text-link">Explore sector <Icon name="arrow" size={16}/></span></div></a>)}</div><a class="text-link catalog-overview-link" href="/industries/">Explore all twelve industries →</a><p class="sector-note">Role examples describe hiring discussions, not verified vacancies or past placements.</p><details class="photo-credits"><summary>Sector photography credits</summary><ul><li><a href="https://commons.wikimedia.org/wiki/File:Hemmingstedt_raffinerie_nacht_uebersichtlich.JPG">Hemmingstedt raffinerie nacht uebersichtlich.JPG</a> — Dirk Ingo Franke, <a href="https://creativecommons.org/licenses/by-sa/2.0/de/">CC BY-SA 2.0 DE</a>. Resized and converted to WebP; manufacturing photo cropped. Illustrative industry setting, not an Adhuni project.</li><li><a href="https://commons.wikimedia.org/wiki/File:Tesla_Robot_Dance_(7408451314).jpg">Tesla Robot Dance (7408451314).jpg</a> — Steve Jurvetson, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>. Resized and converted to WebP; manufacturing photo cropped. Illustrative industry setting, not an Adhuni project.</li></ul><p>Other people imagery remains generated illustration. Restaurant photograph: Vidal Balielo Jr., Pexels.</p></details></div></section>
<section class="section belief-section"><div class="container belief-layout"><img class="belief-image" src="/images/planning.webp" alt="Male professionals reviewing a project plan" width="1800" height="600" loading="lazy"/><div class="belief-copy"><div class="eyebrow light">A SHARED UNDERSTANDING, FROM THE START</div><p class="belief-statement">Need the Right People for Your Business?</p><p>Tell us what you are looking for and let our recruitment team understand your workforce requirements.</p><a class="button navy" href="/employers/#requirement">Submit Your Requirement <Icon name="arrow" size={18}/></a></div></div></section>
<section id="pipelines" class="section border-top"><div class="container"><div class="eyebrow">FOCUSED SEARCH. RELEVANT EXPERIENCE.</div><h2>Focused recruitment for different kinds of work.</h2><div class="tabs pill-tabs" role="tablist" aria-label="Recruitment pipelines">{pipelines.map((p,i)=><button id={`pipeline-tab-${p.id}`} data-pipeline={p.id} role="tab" aria-controls={`pipeline-${p.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{p.label}</button>)}</div>{pipelines.map((p,i)=><div id={`pipeline-${p.id}`} class="split pipeline-panel" role="tabpanel" aria-labelledby={`pipeline-tab-${p.id}`} hidden={i!==0}><img src={`/images/${p.image}`} alt={p.label+' work environment'} width="1400" height="900" loading="lazy"/><div><h3>{p.title}</h3><p>{p.text}</p><ul class="tag-grid">{p.tags.map(t=><li><Icon name="check" size={16}/>{t}</li>)}</ul><a href="#contact" class="button navy">Discuss this requirement <Icon name="arrow" size={17}/></a></div></div>)}</div></section>
<section id="markets" class="section markets-section"><div class="container markets-grid"><div><div class="eyebrow light">ONE CONNECTED RECRUITMENT CONVERSATION</div><h2>Recruitment Beyond Borders.</h2><p>We support employers seeking capable talent for opportunities across the GCC, while helping candidates access legitimate employment opportunities with suitable organisations.</p><div class="market-links">{countries.map(c=><a href={`/locations/${c.slug}/`}><span class={`flag flag-${c.code}`} aria-hidden="true"></span><span>{c.name}<small>Explore recruitment</small></span><span aria-hidden="true">↗</span></a>)}</div><a href="#country-guide" class="button amber">Explore our markets <Icon name="arrow" size={17}/></a></div><div class="map-wrap"><img src="/images/recruitment-map.svg" alt="Map showing recruitment connections between India and Kuwait, Saudi Arabia, UAE, Qatar, Oman and Bahrain" width="760" height="480" loading="lazy"/><span class="map-caption">INDIA ↔ GCC RECRUITMENT CORRIDOR</span></div></div></section>
<section id="country-guide" class="section"><div class="container"><div class="eyebrow">LOCAL CONTEXT. CLEARER CONVERSATIONS.</div><h2>Pick a country. See how hiring starts there.</h2><div class="tabs country-tabs" role="tablist" aria-label="Country hiring guide">{countries.map((c,i)=><button id={`country-tab-${c.slug}`} role="tab" aria-controls={`country-panel-${c.slug}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-country={c.slug}>{c.name}</button>)}</div>{countries.map((c,i)=><div id={`country-panel-${c.slug}`} class="country-panel" role="tabpanel" aria-labelledby={`country-tab-${c.slug}`} hidden={i!==0}><div class="country-cover country-photo"><img src={`/images/country-${c.slug}.webp`} alt={`${c.name} city panorama`} width="1200" height="800" loading="lazy"/><span class={`flag flag-${c.code}`} aria-hidden="true"></span><h3>{c.name}</h3><p>{c.label}</p><span>INDIA ↔ {c.name.toUpperCase()}</span><div class="country-code" aria-hidden="true">{c.code}</div></div><div class="country-details"><h3>Start with a practical brief.</h3><p>{c.text}</p><ol class="country-steps"><li><b>01</b><span><strong>Define the requirement</strong>Roles, responsibilities and essential experience.</span></li><li><b>02</b><span><strong>Agree the selection plan</strong>Interviews, decision owners and expected timing.</span></li><li><b>03</b><span><strong>Confirm the next steps</strong>Employment terms and mobilisation responsibilities.</span></li></ol><a href={`/locations/${c.slug}/`} class="button navy">Explore {c.name} recruitment <Icon name="arrow" size={16}/></a></div></div>)}<details class="photo-credits"><summary>Country photography credits</summary><ul><li><a href="https://commons.wikimedia.org/wiki/File:Kuwait_City_Skyline_1.jpg">Kuwait photograph</a> — Zairon, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</li><li><a href="https://commons.wikimedia.org/wiki/File:Riyadh_Skyline.jpg">Saudi Arabia photograph</a> — B.alotaby, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</li><li><a href="https://commons.wikimedia.org/wiki/File:Dubai_skyline,_Dubai_UAE.jpg">Uae photograph</a> — Stefano Vigorelli, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</li><li><a href="https://commons.wikimedia.org/wiki/File:Doha_skyline.jpg">Qatar photograph</a> — Haakon S. Krohn, <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>.</li><li><a href="https://commons.wikimedia.org/wiki/File:Panoramic_view_of_Muscat,_Oman_(53697954168).jpg">Oman photograph</a> — dronepicr, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>.</li><li><a href="https://commons.wikimedia.org/wiki/File:Manama_Skyline.jpg">Bahrain photograph</a> — Chris Price, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>.</li></ul><p>Photographs resized, converted to WebP and cropped for display. Adapted photographs retain their respective licences.</p></details></div></section>
<section id="approach" class="section approach-section"><div class="container"><div class="eyebrow">OUR RECRUITMENT PROCESS</div><ClientCopy text={client.Services['Our recruitment process']}/><a class="text-link catalog-overview-link" href="/our-approach/">Explore our complete recruitment process →</a><aside class="brief-band"><div><span class="eyebrow">FOR EMPLOYERS</span><h3>A clear path from vacancy to mobilisation.</h3><p>Share your workforce requirements with our recruitment specialists.</p></div><a href="/employers/" class="button navy">Submit Your Requirement →</a></aside></div></section>
<section class="section proof-section" id="credentials"><div class="container credentials-layout"><div><div class="eyebrow">A CLEAR BASIS FOR WORKING TOGETHER</div><h2>Confidence starts<br/>with clarity.</h2><p class="section-intro">Get to know the business behind your recruitment partner before an engagement begins.</p><a class="button navy credentials-link" href="#contact">Discuss company credentials <Icon name="arrow" size={18}/></a></div><div class="credential-cards">{[['01','Relevant experience','Discuss the sectors, role requirements and selection approach relevant to your brief.'],['02','Company credentials','Request the company documentation relevant to your proposed engagement.'],['03','Agreed responsibilities','Clarify scope, communication and next steps. References can be discussed where available and authorised.']].map(([n,title,body])=><article><span>{n}</span><div><h3>{title}</h3><p>{body}</p></div></article>)}</div></div></section>
<section id="candidates" class="section candidate-section"><div class="container candidate-grid"><img src="/images/candidate.webp" alt="Professional in an office" width="800" height="1200" loading="lazy"/><div><div class="eyebrow">FOR CANDIDATES</div><h2>Your Next Opportunity Could Start Here.</h2><p>Submit your CV and profile details so our recruitment team can consider your experience for suitable opportunities.</p><a href="/candidates/" class="button navy">Submit Your CV →</a><p class="small-note">Submitting your CV does not guarantee employment. Selection depends on employer requirements and the recruitment process.</p></div></div></section>

<section class="section fit-section"><div class="container"><div class="eyebrow">THE RIGHT WORKING RELATIONSHIP</div><h2>A considered approach to every appointment.</h2><p class="section-intro">A useful recruitment discussion should leave you with more clarity.</p><ul class="check-list"><li><Icon name="check"/>A brief shaped around the actual work</li><li><Icon name="check"/>Attention to the experience behind the profile</li><li><Icon name="check"/>Clear communication on selection and next steps</li><li><Icon name="check"/>A practical conversation about your market and timeline</li></ul></div></section>
<section id="faq" class="section faq-section"><div class="container faq-wrap"><div class="faq-intro"><div class="eyebrow">FREQUENTLY ASKED QUESTIONS</div><h2>Questions about recruitment?</h2><p>Speak with our team about your industry, workforce size and hiring timeline.</p></div><ClientFAQ questions={client.Services.FAQs.split('\n').filter(line=>line.startsWith('- ')).map(line=>line.slice(2))}/></div></section>
<Contact/>
</Base>
