# Set the final owned domain. Leave localhost for local development.
SITE_URL=https://adhunihrsolutions.com
# Set true ONLY after client content, company details and privacy terms are approved.
PUBLIC_LAUNCH_READY=false
# Enquiries + CRM (docs/crm-setup.md). Enable only after GOOGLE_SHEET_WEBHOOK_URL + GOOGLE_SHEET_SECRET are set, then rebuild.
PUBLIC_CONTACT_ENABLED=false
# Apps Script web app URL (https://script.google.com/macros/s/.../exec). Server-side only.
GOOGLE_SHEET_WEBHOOK_URL=
# Same value as the API_SECRET script property (at least 24 characters). Server-side only; never PUBLIC_.
GOOGLE_SHEET_SECRET=
# CRM admin login. Username defaults to admin. The hash comes from `node scripts/crm-hash-password.mjs`;
# there is no default password and the login stays disabled while this is empty.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD_HASH=
# Host that serves the CRM at its root (Vercel route added at build). Optional.
CRM_HOST=crm.adhunihrsolutions.com
# Local testing only: lets the server call scripts/mock-backend.mjs on 127.0.0.1. Never set in production.
# CRM_BACKEND_ALLOW_LOCAL=true
# Optional Cloudflare Turnstile anti-spam.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=
# Footer trust details. Each is hidden while empty; add only verified values.
PUBLIC_CR_NUMBER=
PUBLIC_LICENCE_NUMBER=
# Office addresses and telephone numbers live in src/data/offices.ts (Contact page directory and country pages).
# Contact page: opening hours, shown only when set (e.g. Sunday to Thursday, 9:00 to 17:00).
PUBLIC_OFFICE_HOURS=
PUBLIC_MARKET_PAGES_LIVE=false
PUBLIC_GUIDES_LIVE=false
PUBLIC_BOOKING_URL=
PUBLIC_GA_MEASUREMENT_ID=
