# Set the final owned domain. Leave localhost for local development.
SITE_URL=http://localhost:4321
# Set true ONLY after client content, company details and privacy terms are approved.
PUBLIC_LAUNCH_READY=false
# Enable after configuring all email + anti-spam values below, then rebuild.
PUBLIC_CONTACT_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Must be a sender verified in your Resend account.
CONTACT_FROM=
# Actual company recipient; do not use an unverified guessed address.
CONTACT_TO=

# Verified client-owned contacts. WhatsApp: international digits only, without +.
PUBLIC_WHATSAPP_NUMBER=
# Top bar phone + response-time message. Hidden while empty. Display format, e.g. +965 1234 5678.
PUBLIC_PHONE_DISPLAY=
PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=
# Footer trust details. Each is hidden while empty; add only verified values.
PUBLIC_OFFICE_ADDRESS=
PUBLIC_CR_NUMBER=
PUBLIC_LICENCE_NUMBER=
# Country page office addresses. Each is shown on its country page (hero and FAQ) only when set; leave empty if there is no office there.
PUBLIC_OFFICE_ADDRESS_KUWAIT=
PUBLIC_OFFICE_ADDRESS_SAUDI_ARABIA=
PUBLIC_OFFICE_ADDRESS_UAE=
PUBLIC_OFFICE_ADDRESS_QATAR=
PUBLIC_OFFICE_ADDRESS_OMAN=
PUBLIC_OFFICE_ADDRESS_BAHRAIN=
# Contact page: opening hours, shown only when set (e.g. Sunday to Thursday, 9:00 to 17:00).
PUBLIC_OFFICE_HOURS=
