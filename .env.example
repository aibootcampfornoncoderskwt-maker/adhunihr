# Set the final owned domain. Leave localhost for local development.
SITE_URL=https://adhunihrsolutions.com
# Set true ONLY after client content, company details and privacy terms are approved.
PUBLIC_LAUNCH_READY=false
# Enable after configuring GOOGLE_SHEET_WEBHOOK_URL + GOOGLE_SHEET_SECRET (docs/google-sheets-setup.md), then rebuild. Resend email and Turnstile below are optional.
PUBLIC_CONTACT_ENABLED=false
# Google Sheet collection: the Apps Script web app URL (https://script.google.com/macros/s/.../exec) and the shared secret set inside the script.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Must be a sender verified in your Resend account.
CONTACT_FROM=
# Actual company recipient; do not use an unverified guessed address.
CONTACT_TO=

PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=
# Footer trust details. Each is hidden while empty; add only verified values.
PUBLIC_CR_NUMBER=
PUBLIC_LICENCE_NUMBER=
# Office addresses and telephone numbers live in src/data/offices.ts (Contact page directory and country pages).
# Contact page: opening hours, shown only when set (e.g. Sunday to Thursday, 9:00 to 17:00).
PUBLIC_OFFICE_HOURS=
PUBLIC_MARKET_PAGES_LIVE=false
PUBLIC_GUIDES_LIVE=false
PUBLIC_BOOKING_URL=
PUBLIC_GA_MEASUREMENT_ID=
